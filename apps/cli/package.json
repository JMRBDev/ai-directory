{
  "name": "@jmrbdev/ai-directory",
  "version": "0.1.0",
  "description": "Browse a Git-backed catalog of AI dev resources and install them into your coding harnesses",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aid": "dist/main.cjs"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsup && pnpm copy-web-dist && node scripts/add-shebang.mjs && chmod +x dist/main.cjs",
    "copy-web-dist": "node scripts/copy-web-dist.mjs",
    "prepack": "pnpm build",
    "clean": "rm -rf dist",
    "dev": "bun run src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@hono/node-server": "^2.1.0",
    "citty": "^0.2.2",
    "env-paths": "^4.0.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
