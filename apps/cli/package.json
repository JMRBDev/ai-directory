{
  "name": "@ai-directory/cli",
  "private": true,
  "type": "module",
  "bin": {
    "aid": "dist/aid"
  },
  "scripts": {
    "build": "bun build src/main.ts --compile --outfile dist/aid",
    "clean": "rm -rf dist",
    "dev": "bun run src/main.ts",
    "test": "vitest run --passWithNoTests --exclude 'dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-directory/contracts": "workspace:*",
    "@ai-directory/domain": "workspace:*",
    "@ai-directory/installers": "workspace:*",
    "@ai-directory/registry": "workspace:*",
    "@ai-directory/server-core": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "citty": "^0.2.2",
    "env-paths": "^4.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
