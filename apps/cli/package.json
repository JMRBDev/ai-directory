{
  "name": "@ai-directory/cli",
  "private": true,
  "type": "module",
  "bin": {
    "aid": "dist/aid"
  },
  "scripts": {
    "build": "bun build src/main.ts --compile --asset \"$(bun scripts/resolve-web-dist.ts)\" --outfile dist/aid",
    "build:darwin:arm64": "bun build src/main.ts --compile --target=bun-darwin-arm64 --asset \"$(bun scripts/resolve-web-dist.ts)\" --outfile dist/aid-darwin-arm64",
    "build:darwin:x64": "bun build src/main.ts --compile --target=bun-darwin-x64 --asset \"$(bun scripts/resolve-web-dist.ts)\" --outfile dist/aid-darwin-x64",
    "build:linux:x64": "bun build src/main.ts --compile --target=bun-linux-x64 --asset \"$(bun scripts/resolve-web-dist.ts)\" --outfile dist/aid-linux-x64",
    "build:windows:x64": "bun build src/main.ts --compile --target=bun-windows-x64 --asset \"$(bun scripts/resolve-web-dist.ts)\" --outfile dist/aid-windows-x64.exe",
    "clean": "rm -rf dist",
    "dev": "bun run src/main.ts",
    "test": "vitest run --passWithNoTests --exclude 'dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-directory/config": "workspace:*",
    "@ai-directory/contracts": "workspace:*",
    "@ai-directory/installers": "workspace:*",
    "@ai-directory/registry": "workspace:*",
    "@ai-directory/server-core": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "@ai-directory/web": "workspace:*"
  }
}
