{
  "name": "@ai-directory/cli",
  "private": true,
  "type": "module",
  "bin": {
    "aid": "dist/aid"
  },
  "scripts": {
    "build": "bun build src/main.ts --compile --asset ../web/dist --outfile dist/aid",
    "build:darwin:arm64": "bun build src/main.ts --compile --target=bun-darwin-arm64 --asset ../web/dist --outfile dist/aid-darwin-arm64",
    "build:darwin:x64": "bun build src/main.ts --compile --target=bun-darwin-x64 --asset ../web/dist --outfile dist/aid-darwin-x64",
    "build:linux:x64": "bun build src/main.ts --compile --target=bun-linux-x64 --asset ../web/dist --outfile dist/aid-linux-x64",
    "build:windows:x64": "bun build src/main.ts --compile --target=bun-windows-x64 --asset ../web/dist --outfile dist/aid-windows-x64.exe",
    "release:build": "pnpm --filter \"@ai-directory/cli...\" build && pnpm --filter @ai-directory/cli build:darwin:arm64 && pnpm --filter @ai-directory/cli build:darwin:x64 && pnpm --filter @ai-directory/cli build:linux:x64 && pnpm --filter @ai-directory/cli build:windows:x64",
    "clean": "rm -rf dist",
    "dev": "bun run src/main.ts",
    "test": "vitest run --passWithNoTests --exclude 'dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "pnpm --filter @ai-directory/web build"
  },
  "dependencies": {
    "@ai-directory/config": "workspace:*",
    "@ai-directory/contracts": "workspace:*",
    "@ai-directory/installers": "workspace:*",
    "@ai-directory/registry": "workspace:*",
    "@ai-directory/server-core": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
