---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const apiUrl = import.meta.env.PUBLIC_AI_DIRECTORY_API_URL ?? 'http://127.0.0.1:4317';
---

<!doctype html>
<html lang="en" data-api-url={apiUrl}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Configure the local AI Directory connection." />
    <ThemeInit />
    <title>Settings | AI Directory</title>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <header class="border-b border-line bg-canvas/95 dark:border-zinc-800 dark:bg-zinc-950/95">
      <div class="mx-auto flex min-h-16 max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-3 sm:px-8">
        <a class="text-sm font-semibold tracking-[0.12em] text-ink dark:text-zinc-100" href="/">
          AI DIRECTORY <span class="ml-2 hidden text-[10px] font-medium tracking-[0.16em] text-muted sm:inline">RESOURCE REGISTRY</span>
        </a>
        <div class="flex items-center gap-4 text-xs font-medium text-muted dark:text-zinc-400">
          <span class="hidden sm:inline">Local setup</span>
          <ThemeToggle />
          <a class="text-ink transition-colors hover:text-accent dark:text-zinc-200 dark:hover:text-orange-300" href="/">Catalog</a>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-8 lg:py-12">
      <a class="text-sm font-medium text-muted transition-colors hover:text-accent dark:text-zinc-400 dark:hover:text-orange-300" href="/">Back to catalog</a>

      <section class="mt-10 max-w-3xl" aria-labelledby="page-title">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Local setup</p>
        <h1 id="page-title" class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-zinc-100">Connect your registry.</h1>
        <p class="mt-4 text-base leading-7 text-muted dark:text-zinc-400">
          Choose the Git repository that contains the production resource index. The CLI and this local website use the same setting.
        </p>
      </section>

      <section class="mt-12 w-full" aria-labelledby="connection-title">
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5 dark:border-zinc-800">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Connection</p>
            <h2 id="connection-title" class="mt-2 text-xl font-semibold tracking-tight text-ink dark:text-zinc-100">Registry repository</h2>
          </div>
          <span class="rounded-full border border-line px-2.5 py-1 text-xs font-medium text-muted dark:border-zinc-700 dark:text-zinc-400" data-source>Loading</span>
        </div>

        <form class="mt-6 space-y-6" data-settings-form>
          <div>
            <label class="mb-2 block text-sm font-semibold text-ink dark:text-zinc-200" for="repository">Git URL</label>
            <input class="block min-h-11 w-full rounded-md border border-line bg-panel px-3 text-sm text-ink outline-none transition placeholder:text-muted/70 focus:border-accent focus:ring-2 focus:ring-accent/20 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-600" id="repository" name="repository" type="text" placeholder="git@github.com:company/ai-directory-registry.git" autocomplete="off" required />
          </div>

          <fieldset>
            <legend class="mb-3 text-sm font-semibold text-ink dark:text-zinc-200">Save for</legend>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="flex cursor-pointer items-center gap-3 rounded-md border border-line bg-panel px-3 py-3 text-sm text-ink transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent-soft dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:has-[:checked]:border-orange-400 dark:has-[:checked]:bg-orange-950/30">
                <input class="size-4 accent-accent" type="radio" name="scope" value="user" checked />
                This user
              </label>
              <label class="flex cursor-pointer items-center gap-3 rounded-md border border-line bg-panel px-3 py-3 text-sm text-ink transition-colors has-[:checked]:border-accent has-[:checked]:bg-accent-soft dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:has-[:checked]:border-orange-400 dark:has-[:checked]:bg-orange-950/30">
                <input class="size-4 accent-accent" type="radio" name="scope" value="project" />
                This project
              </label>
            </div>
          </fieldset>

          <div class="flex flex-wrap gap-3">
            <button class="inline-flex min-h-10 items-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" type="submit">Save settings</button>
            <button class="inline-flex min-h-10 items-center rounded-md border border-line px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-orange-400 dark:hover:text-orange-300" type="button" data-clear>Clear selected scope</button>
          </div>
          <p class="text-sm text-muted dark:text-zinc-400" data-status role="status"></p>
        </form>
      </section>

      <div class="mt-10 flex w-full flex-col gap-4 border-t border-line pt-5 text-sm sm:flex-row sm:items-center sm:justify-between dark:border-zinc-800">
        <div>
          <p class="font-semibold text-ink dark:text-zinc-100">Credentials</p>
          <p class="mt-1 text-muted dark:text-zinc-400">AI Directory uses the Git credentials already configured on this computer.</p>
        </div>
        <code class="w-fit rounded-md bg-ink px-3 py-2 font-mono text-xs text-white dark:bg-zinc-800 dark:text-zinc-200">aid doctor</code>
      </div>
    </main>

    <footer class="mx-auto flex w-full max-w-6xl flex-col gap-2 border-t border-line px-5 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8 dark:border-zinc-800 dark:text-zinc-500">
      <p>Backed by the production branch of the resources repository.</p>
      <a class="font-medium hover:text-accent dark:hover:text-orange-300" href="/">Return to catalog</a>
    </footer>

    <script>
      const apiBase = document.documentElement.dataset.apiUrl ?? 'http://127.0.0.1:4317';
      const form = document.querySelector<HTMLFormElement>('[data-settings-form]');
      const repository = document.querySelector<HTMLInputElement>('#repository');
      const source = document.querySelector<HTMLElement>('[data-source]');
      const status = document.querySelector<HTMLElement>('[data-status]');
      const clear = document.querySelector<HTMLButtonElement>('[data-clear]');

      function selectedScope(): string {
        return document.querySelector<HTMLInputElement>('input[name="scope"]:checked')?.value ?? 'user';
      }

      function selectScope(scope: string) {
        if (scope !== 'user' && scope !== 'project') return;
        const input = document.querySelector<HTMLInputElement>(`input[name="scope"][value="${scope}"]`);
        if (input) input.checked = true;
      }

      function showStatus(message: string, isError = false) {
        if (!status) return;
        status.textContent = message;
        status.dataset.error = isError ? 'true' : 'false';
      }

      async function loadSettings() {
        try {
          const response = await fetch(`${apiBase}/api/config`);
          const result = await response.json();
          if (!response.ok) throw new Error(result.error ?? 'Could not load settings.');

          if (repository && result.repository) repository.value = result.repository;
          selectScope(result.source);
          if (source) source.textContent = result.source === 'none' ? 'Not configured' : result.source;
          showStatus(result.repository ? 'Ready to use.' : 'Enter a registry repository to get started.');
        } catch (error) {
          showStatus(error instanceof Error ? error.message : 'Could not reach the local API.', true);
        }
      }

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const value = repository?.value.trim() ?? '';

        if (!value) {
          showStatus('A Git URL is required.', true);
          return;
        }

        showStatus('Saving…');

        try {
          const response = await fetch(`${apiBase}/api/config`, {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ repository: value, scope: selectedScope() }),
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error ?? 'Could not save settings.');

          if (source) source.textContent = result.source;
          if (result.source !== result.savedScope) {
            showStatus(
              `Saved in the ${result.savedScope} config. The ${result.source} setting is still active.`,
            );
          } else {
            showStatus(`Saved in the ${result.savedScope} config.`);
          }
        } catch (error) {
          showStatus(error instanceof Error ? error.message : 'Could not save settings.', true);
        }
      });

      clear?.addEventListener('click', async () => {
        showStatus('Clearing…');

        try {
          const response = await fetch(`${apiBase}/api/config?scope=${selectedScope()}`, {
            method: 'DELETE',
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error ?? 'Could not clear settings.');

          if (repository) repository.value = result.repository ?? '';
          if (source) source.textContent = result.source === 'none' ? 'Not configured' : result.source;
          if (result.source !== 'none' && result.source !== result.clearedScope) {
            showStatus(
              `Cleared the ${result.clearedScope} config. The ${result.source} setting is still active.`,
            );
          } else {
            showStatus(`Cleared the ${result.clearedScope} config.`);
          }
        } catch (error) {
          showStatus(error instanceof Error ? error.message : 'Could not clear settings.', true);
        }
      });

      loadSettings();
    </script>
  </body>
</html>
