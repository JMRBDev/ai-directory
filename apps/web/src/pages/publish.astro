---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SettingsDrawer from '../components/SettingsDrawer.astro';

const apiUrl = import.meta.env.PUBLIC_AI_DIRECTORY_API_URL ?? 'http://127.0.0.1:4317';
---

<!doctype html>
<html lang="en" data-api-url={apiUrl}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Publish an AI Directory resource for review." />
    <ThemeInit />
    <title>Publish | AI Directory</title>
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased">
    <SiteHeader showSettings sourceLabel="Local publishing" />

    <main class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-8 lg:py-12">
      <a class="btn btn-ghost btn-sm -ml-3" href="/">Back to catalog</a>

      <section class="mt-10 max-w-3xl" aria-labelledby="page-title">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Share a resource</p>
        <h1 id="page-title" class="mt-3 text-3xl font-semibold tracking-tight text-base-content sm:text-4xl">Publish for review.</h1>
        <p class="mt-4 text-base leading-7 text-base-content/60">
          Select a resource directory. AI Directory validates it locally, then opens a pull request against the production registry.
        </p>
      </section>

      <section class="mt-12 w-full" aria-labelledby="publish-title">
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-base-300 pb-5">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Pull request</p>
            <h2 id="publish-title" class="mt-2 text-xl font-semibold tracking-tight text-base-content">Resource details</h2>
          </div>
          <span class="badge badge-ghost">Local API</span>
        </div>

        <form class="mt-6 space-y-6" data-publish-form>
          <div class="grid gap-5 md:grid-cols-[minmax(0,1fr)_10rem]">
            <fieldset class="fieldset rounded-box border border-base-300 p-4">
              <legend class="fieldset-legend">Resource ID</legend>
              <div class="grid gap-4 sm:grid-cols-[10rem_10rem_minmax(0,1fr)]">
                <label class="fieldset" for="resource-owner">
                  <span class="fieldset-legend text-xs">GitHub user</span>
                  <input class="input input-bordered w-full" id="resource-owner" type="text" placeholder="Loading…" disabled />
                </label>
                <label class="fieldset" for="resource-type">
                  <span class="fieldset-legend text-xs">Type</span>
                  <select class="select select-bordered w-full" id="resource-type" required>
                    <option value="skills">Skill</option>
                    <option value="agents">Agent</option>
                    <option value="rules">Rule</option>
                    <option value="templates">Template</option>
                  </select>
                </label>
                <label class="fieldset" for="resource-name">
                  <span class="fieldset-legend text-xs">Name</span>
                  <input class="input input-bordered w-full" id="resource-name" type="text" placeholder="my-resource" autocomplete="off" required />
                </label>
              </div>
            </fieldset>
            <label class="fieldset" for="resource-version">
              <span class="fieldset-legend">Version</span>
              <input class="input input-bordered w-full" id="resource-version" name="version" type="text" value="1.0.0" autocomplete="off" required />
            </label>
          </div>

          <label class="card cursor-pointer border border-dashed border-base-300 bg-base-100 transition-colors hover:border-primary" for="resource-directory">
            <div class="card-body p-5">
              <span class="text-sm font-semibold text-base-content">Resource directory</span>
              <span class="mt-1 text-sm text-base-content/60">Choose the folder that contains the resource files.</span>
              <input class="file-input file-input-bordered mt-4 w-full" id="resource-directory" type="file" data-directory-input multiple required />
              <span class="mt-3 text-xs text-base-content/60" data-file-name>Select a folder containing the resource files.</span>
            </div>
          </label>

          <div class="card border border-base-300 bg-base-100" aria-live="polite">
            <div class="card-body p-4">
              <strong class="text-sm font-semibold text-base-content" data-file-count>No files selected</strong>
              <ul class="mt-3 max-h-40 space-y-1 overflow-y-auto font-mono text-xs text-base-content/60" data-file-list></ul>
            </div>
          </div>

          <div class="card hidden border border-base-300 bg-base-100" data-description-editor hidden>
            <div class="card-body p-4">
            <label class="fieldset" for="description-override">
              <span class="fieldset-legend">Description</span>
              <textarea class="textarea textarea-bordered min-h-24 w-full" id="description-override" rows="3" placeholder="The resource description will appear here after validation."></textarea>
            </label>
            <span class="mt-2 text-xs text-base-content/60">Inferred from the resource files. Edit if needed.</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-3">
            <button class="btn btn-primary" type="submit" data-validate-action>Validate resource</button>
            <button class="btn btn-outline hidden" type="button" data-submit-action hidden disabled>
              Submit pull request
            </button>
          </div>
          <p class="text-sm text-base-content/60" data-publish-status role="status"></p>
        </form>

        <div class="card mt-10 hidden border border-base-300 bg-base-100" data-publish-review hidden>
          <div class="card-body p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Review</p>
          <h2 class="mt-2 text-lg font-semibold tracking-tight text-base-content">Ready to submit</h2>
          <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2">
            <div class="border-t border-base-300 pt-3">
              <dt class="text-xs font-semibold text-base-content/60">Resource</dt>
              <dd class="mt-1 break-all font-mono text-xs text-base-content" data-review-resource></dd>
            </div>
            <div class="border-t border-base-300 pt-3">
              <dt class="text-xs font-semibold text-base-content/60">Version</dt>
              <dd class="mt-1 text-base-content" data-review-version></dd>
            </div>
            <div class="border-t border-base-300 pt-3">
              <dt class="text-xs font-semibold text-base-content/60">Entry file</dt>
              <dd class="mt-1 font-mono text-xs text-base-content" data-review-entry></dd>
            </div>
            <div class="border-t border-base-300 pt-3">
              <dt class="text-xs font-semibold text-base-content/60">Files</dt>
              <dd class="mt-1 text-base-content" data-review-files></dd>
            </div>
            <div class="border-t border-base-300 pt-3 sm:col-span-2">
              <dt class="text-xs font-semibold text-base-content/60">Description</dt>
              <dd class="mt-1 leading-6 text-base-content" data-review-description></dd>
            </div>
          </dl>
          <p class="mt-5 text-sm leading-6 text-base-content/60">
            The pull request will be unreviewed until the curation team reviews and merges it.
          </p>
          <a class="link link-primary mt-4 hidden text-sm font-semibold" data-pull-request-link target="_blank" rel="noreferrer" hidden>
            Open pull request
          </a>
          </div>
        </div>
      </section>
    </main>

    <SettingsDrawer />

    <footer class="footer mx-auto w-full max-w-6xl border-t border-base-300 px-5 py-6 text-xs text-base-content/60 sm:px-8">
      <p>Backed by the production branch of the resources repository.</p>
      <a class="link link-hover font-medium" href="/">Return to catalog</a>
    </footer>

    <script>
      type DirectoryFile = File & { webkitRelativePath?: string };

      const apiBase = document.documentElement.dataset.apiUrl ?? 'http://127.0.0.1:4317';
      const form = document.querySelector<HTMLFormElement>('[data-publish-form]');
      const resourceOwner = document.querySelector<HTMLInputElement>('#resource-owner');
      const resourceType = document.querySelector<HTMLSelectElement>('#resource-type');
      const resourceName = document.querySelector<HTMLInputElement>('#resource-name');
      const version = document.querySelector<HTMLInputElement>('#resource-version');
      const directory = document.querySelector<HTMLInputElement>('#resource-directory');
      const fileName = document.querySelector<HTMLElement>('[data-file-name]');
      const fileCount = document.querySelector<HTMLElement>('[data-file-count]');
      const fileList = document.querySelector<HTMLUListElement>('[data-file-list]');
      const descriptionEditor = document.querySelector<HTMLElement>('[data-description-editor]');
      const descriptionOverride = document.querySelector<HTMLTextAreaElement>('#description-override');
      const validate = document.querySelector<HTMLButtonElement>('[data-validate-action]');
      const submit = document.querySelector<HTMLButtonElement>('[data-submit-action]');
      const status = document.querySelector<HTMLElement>('[data-publish-status]');
      const review = document.querySelector<HTMLElement>('[data-publish-review]');
      const pullRequestLink = document.querySelector<HTMLAnchorElement>('[data-pull-request-link]');
      let selectedFiles: DirectoryFile[] = [];
      let validated = false;

      function setHidden(element: HTMLElement | null, hidden: boolean) {
        if (!element) return;
        element.hidden = hidden;
        element.classList.toggle('hidden', hidden);
      }

      directory?.setAttribute('webkitdirectory', '');

      function pathFor(file: DirectoryFile): string {
        const path = file.webkitRelativePath || file.name;
        const parts = path.split('/');
        return parts.length > 1 ? parts.slice(1).join('/') : path;
      }

      function showStatus(message: string, isError = false) {
        if (!status) return;
        status.textContent = message;
        status.dataset.error = isError ? 'true' : 'false';
      }

      function composedResourceId(): string {
        return [resourceOwner?.value.trim(), resourceType?.value, resourceName?.value.trim()].join('/');
      }

      function resetValidation() {
        validated = false;
        setHidden(review, true);
        setHidden(descriptionEditor, true);
        if (submit) {
          setHidden(submit, true);
          submit.disabled = true;
        }
      }

      function renderFiles() {
        const paths = selectedFiles.map(pathFor).sort();
        if (fileCount) {
          fileCount.textContent = paths.length === 0
            ? 'No files selected'
            : `${paths.length} file${paths.length === 1 ? '' : 's'} selected`;
        }
        if (fileName) {
          const folder = selectedFiles[0]?.webkitRelativePath?.split('/')[0];
          fileName.textContent = paths[0]
            ? `Selected folder: ${folder ?? 'resource files'}`
            : 'Select a folder containing the resource files.';
        }
        if (!fileList) return;

        const visible = paths.slice(0, 12).map((path) => {
          const item = document.createElement('li');
          item.textContent = path;
          return item;
        });
        if (paths.length > 12) {
          const item = document.createElement('li');
          item.textContent = `…and ${paths.length - 12} more`;
          visible.push(item);
        }
        fileList.replaceChildren(...visible);
      }

      function formData(): FormData {
        const data = new FormData();
        data.set('resourceId', composedResourceId());
        data.set('version', version?.value.trim() ?? '');
        if (!descriptionEditor?.hidden && descriptionOverride?.value.trim()) {
          data.set('description', descriptionOverride.value.trim());
        }
        for (const file of selectedFiles) data.append('files[]', file, pathFor(file));
        return data;
      }

      async function request(path: string): Promise<Record<string, unknown>> {
        const response = await fetch(`${apiBase}${path}`, {
          method: 'POST',
          body: formData(),
        });
        const result = await response.json().catch(() => ({})) as Record<string, unknown>;
        if (!response.ok) throw new Error(typeof result.error === 'string' ? result.error : 'The local API request failed.');
        return result;
      }

      async function loadGithubUsername() {
        try {
          const response = await fetch(`${apiBase}/api/github-user`);
          const result = await response.json().catch(() => ({})) as Record<string, unknown>;
          if (!response.ok || typeof result.username !== 'string') {
            throw new Error(typeof result.error === 'string' ? result.error : 'Could not determine the GitHub username.');
          }

          if (resourceOwner) resourceOwner.value = result.username;
        } catch (error) {
          if (resourceOwner) resourceOwner.placeholder = 'Unavailable';
          showStatus(error instanceof Error ? error.message : 'Could not determine the GitHub username.', true);
        }
      }

      function setBusy(busy: boolean) {
        for (const field of [resourceType, resourceName, version, descriptionOverride, directory]) {
          if (field) field.disabled = busy;
        }
        if (validate) validate.disabled = busy;
        if (submit) submit.disabled = busy || !validated;
      }

      function showReview(result: Record<string, unknown>) {
        const files = Array.isArray(result.files)
          ? result.files.filter((file): file is string => typeof file === 'string')
          : [];
        const setText = (selector: string, value: string) => {
          const element = document.querySelector<HTMLElement>(selector);
          if (element) element.textContent = value;
        };

        setText('[data-review-resource]', String(result.resource ?? composedResourceId()));
        setText('[data-review-version]', String(result.version ?? version?.value ?? ''));
        setText('[data-review-entry]', String(result.entryFile ?? 'Not found'));
        setText('[data-review-files]', `${files.length} file${files.length === 1 ? '' : 's'}`);
        const description = typeof result.description === 'string' ? result.description.trim() : '';
        setText('[data-review-description]', description || 'Not found');
        setHidden(review, false);
        if (descriptionOverride) descriptionOverride.value = description;
        setHidden(descriptionEditor, selectedFiles.length === 0 || !description);
        validated = true;
        if (submit) {
          setHidden(submit, false);
          submit.disabled = false;
        }
      }

      directory?.addEventListener('change', () => {
        selectedFiles = Array.from(directory.files ?? []) as DirectoryFile[];
        renderFiles();
        resetValidation();
      });

      for (const field of [resourceType, resourceName, version]) {
        field?.addEventListener('input', resetValidation);
      }

      resourceType?.addEventListener('change', resetValidation);

      descriptionOverride?.addEventListener('input', () => {
        const reviewDescription = document.querySelector<HTMLElement>('[data-review-description]');
        if (reviewDescription) reviewDescription.textContent = descriptionOverride.value.trim() || 'Not found';
      });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (selectedFiles.length === 0) {
          showStatus('Select a resource directory first.', true);
          return;
        }
        if (!resourceOwner?.value.trim()) {
          showStatus('The authenticated GitHub username is required.', true);
          return;
        }

        setBusy(true);
        showStatus('Validating resource…');
        try {
          const result = await request('/api/validate');
          showReview(result);
          showStatus('Validation passed. Review the files, then submit the pull request.');
        } catch (error) {
          showStatus(error instanceof Error ? error.message : 'Could not validate the resource.', true);
        } finally {
          setBusy(false);
        }
      });

      submit?.addEventListener('click', async () => {
        if (!validated || !window.confirm('Create this pull request?')) return;

        setBusy(true);
        showStatus('Creating pull request…');
        try {
          const result = await request('/api/submit');
          const pullRequestUrl = typeof result.pullRequestUrl === 'string'
            ? result.pullRequestUrl
            : '';
          if (pullRequestLink && pullRequestUrl) {
            pullRequestLink.href = pullRequestUrl;
            setHidden(pullRequestLink, false);
          }
          showStatus(
            pullRequestUrl
              ? `Pull request created: ${pullRequestUrl}`
              : 'Pull request created.',
          );
          validated = false;
          setHidden(submit, true);
        } catch (error) {
          showStatus(error instanceof Error ? error.message : 'Could not create the pull request.', true);
        } finally {
          setBusy(false);
        }
      });

      renderFiles();
      loadGithubUsername();
    </script>
  </body>
</html>
