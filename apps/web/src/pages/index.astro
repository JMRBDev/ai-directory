---
import type { ResourceSummary } from '@ai-directory/contracts';
import { loadRegistry, refreshRegistry, resourceId } from '../lib/registry';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

if (Astro.url.searchParams.get('refresh') === '1') await refreshRegistry();
const registry = await loadRegistry();
const resources = (registry.index?.resources ?? [])
  .filter((resource) => resource.lifecycleStatus === 'active')
  .sort((left, right) => resourceId(left).localeCompare(resourceId(right)));
const reviewedCount = resources.filter((resource) => resource.reviewStatus === 'reviewed').length;
const resourceTypes = new Set(resources.map((resource) => resource.type)).size;
const title = 'AI Directory | Internal resource registry';
const apiUrl = import.meta.env.PUBLIC_AI_DIRECTORY_API_URL ?? 'http://127.0.0.1:4317';

function detailPath(resource: ResourceSummary): string {
  return `/resources/${resource.owner}/${resource.type}/${resource.name}/`;
}

function statusLabel(resource: ResourceSummary): string {
  return resource.reviewStatus === 'reviewed' ? 'Reviewed' : 'Unreviewed';
}
---

<!doctype html>
<html lang="en" data-api-url={apiUrl}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Internal catalog of reusable AI development resources."
    />
    <ThemeInit />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
      href="#catalog"
    >Skip to catalog</a>
    <header class="border-b border-line bg-canvas/95 dark:border-zinc-800 dark:bg-zinc-950/95">
      <div class="mx-auto flex min-h-16 max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-3 sm:px-8">
        <a class="text-sm font-semibold tracking-[0.12em] text-ink dark:text-zinc-100" href="/">
          AI DIRECTORY
        </a>
        <div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 text-xs font-medium text-muted">
          <button class="inline-flex min-h-8 items-center gap-2 rounded-md border border-line px-2.5 py-1 text-xs font-semibold text-ink transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-orange-400 dark:hover:text-orange-300" type="button" data-open-deck aria-controls="change-deck" aria-expanded="false">
            Changes <span class="rounded-full bg-accent-soft px-1.5 py-0.5 text-[10px] tabular-nums text-accent" data-deck-count>0</span>
          </button>
          <ThemeToggle />
          <a class="inline-flex size-8 items-center justify-center rounded-md text-ink transition-colors hover:bg-accent-soft hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-zinc-200 dark:hover:bg-orange-950/30 dark:hover:text-orange-300" href="/publish/" title="Publish resource" aria-label="Publish resource">
            <i class="ph ph-upload-simple text-lg" aria-hidden="true"></i>
            <span class="sr-only">Publish resource</span>
          </a>
          <a class="inline-flex size-8 items-center justify-center rounded-md text-ink transition-colors hover:bg-accent-soft hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-zinc-200 dark:hover:bg-orange-950/30 dark:hover:text-orange-300" href="/?refresh=1" title="Refresh registry" aria-label="Refresh registry">
            <i class="ph ph-arrow-clockwise text-lg" aria-hidden="true"></i>
            <span class="sr-only">Refresh registry</span>
          </a>
          <a class="inline-flex size-8 items-center justify-center rounded-md text-ink transition-colors hover:bg-accent-soft hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-zinc-200 dark:hover:bg-orange-950/30 dark:hover:text-orange-300" href="/settings/" title="Settings" aria-label="Settings">
            <i class="ph ph-gear text-lg" aria-hidden="true"></i>
            <span class="sr-only">Settings</span>
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-5 py-10 sm:px-8 lg:py-14">
      <section class="w-full" aria-labelledby="page-title">
        <h1 id="page-title" class="max-w-2xl text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-zinc-100">
          Find a resource for the work in front of you.
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-muted dark:text-zinc-400">
          Shared skills, agents, rules, and templates. Read the source, check the review status, and
          install what you need locally.
        </p>
        <div class="mt-8 grid w-full grid-cols-3 divide-x divide-line border-y border-line py-4 dark:divide-zinc-800 dark:border-zinc-800" aria-label="Registry summary">
          <div class="pr-4">
            <strong class="block text-2xl font-semibold tracking-tight text-ink dark:text-zinc-100">{resources.length}</strong>
            <span class="mt-1 block text-xs text-muted dark:text-zinc-500">Active</span>
          </div>
          <div class="px-4">
            <strong class="block text-2xl font-semibold tracking-tight text-ink dark:text-zinc-100">{reviewedCount}</strong>
            <span class="mt-1 block text-xs text-muted dark:text-zinc-500">Reviewed</span>
          </div>
          <div class="pl-4">
            <strong class="block text-2xl font-semibold tracking-tight text-ink dark:text-zinc-100">{resourceTypes}</strong>
            <span class="mt-1 block text-xs text-muted dark:text-zinc-500">Types</span>
          </div>
        </div>
      </section>

      <section id="catalog" class="mt-14" aria-labelledby="catalog-title">
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5 dark:border-zinc-800">
          <div>
            <h2 id="catalog-title" class="text-xl font-semibold tracking-tight text-ink dark:text-zinc-100">Available resources</h2>
          </div>
          <p class="text-xs text-muted dark:text-zinc-500">
            Source: {registry.source === 'remote' ? 'configured Git registry' : 'explicit local index'}
          </p>
        </div>

        {registry.error ? (
          <div class="mt-6 rounded-lg border border-red-200 bg-red-50 p-5 text-sm dark:border-red-900/70 dark:bg-red-950/30" role="alert">
            <strong class="font-semibold text-red-900 dark:text-red-200">Could not load the registry.</strong>
            <p class="mt-2 text-red-800 dark:text-red-300">{registry.error}</p>
            <p class="mt-2 text-red-800 dark:text-red-300">Run <code class="rounded bg-red-100 px-1.5 py-0.5 font-mono text-xs dark:bg-red-900/50">aid setup</code> or pass <code class="rounded bg-red-100 px-1.5 py-0.5 font-mono text-xs dark:bg-red-900/50">--index &lt;path&gt;</code>.</p>
          </div>
        ) : resources.length === 0 ? (
          <div class="mt-6 rounded-lg border border-line bg-panel p-6 dark:border-zinc-800 dark:bg-zinc-900">
            <strong class="font-semibold text-ink dark:text-zinc-100">No active resources yet.</strong>
            <p class="mt-2 text-sm text-muted dark:text-zinc-400">Submit the first resource with the CLI, then refresh the registry.</p>
          </div>
        ) : (
          <>
            <div class="mt-6 grid gap-4 rounded-lg border border-line bg-panel p-4 sm:grid-cols-[minmax(0,1fr)_12rem_auto] sm:items-end dark:border-zinc-800 dark:bg-zinc-900" role="search">
              <div>
                <label class="mb-2 block text-xs font-semibold text-muted dark:text-zinc-400" for="resource-search">Search</label>
                <input
                  class="block min-h-10 w-full rounded-md border border-line bg-canvas px-3 text-sm text-ink outline-none transition placeholder:text-muted/70 focus:border-accent focus:ring-2 focus:ring-accent/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100 dark:placeholder:text-zinc-600"
                  id="resource-search" type="search" placeholder="Name, owner, or description" autocomplete="off"
                />
              </div>
              <div>
                <label class="mb-2 block text-xs font-semibold text-muted dark:text-zinc-400" for="resource-type">Type</label>
                <select class="block min-h-10 w-full rounded-md border border-line bg-canvas px-3 text-sm text-ink outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100" id="resource-type">
                  <option value="all">All types</option>
                  <option value="skills">Skills</option>
                  <option value="agents">Agents</option>
                  <option value="rules">Rules</option>
                  <option value="templates">Templates</option>
                </select>
              </div>
              <p class="pb-2 text-xs text-muted dark:text-zinc-500" aria-live="polite" data-result-count>
                {resources.length} results
              </p>
            </div>

            <div class="mt-4 grid gap-x-8 md:grid-cols-2" data-resource-grid>
              {resources.map((resource) => (
                <article
                  class="border-t border-line py-5 first:border-t-0 md:[&:nth-child(2)]:border-t-0 dark:border-zinc-800"
                  data-resource
                  data-type={resource.type}
                  data-resource-id={resourceId(resource)}
                  data-search={`${resourceId(resource)} ${resource.description}`.toLowerCase()}
                >
                  <div class="flex items-center justify-between gap-3 text-xs">
                    <label class="flex cursor-pointer items-center gap-2 text-muted dark:text-zinc-400">
                      <input class="size-4 accent-accent" type="checkbox" data-resource-select aria-label={`Select ${resource.name}`} />
                      <span class="font-semibold uppercase tracking-[0.12em] text-accent">{resource.type}</span>
                    </label>
                    <span
                      class:list={[
                        'rounded-full border px-2 py-0.5 font-medium',
                        resource.reviewStatus === 'unreviewed'
                          ? 'border-amber-200 bg-warning-soft text-warning dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-300'
                          : 'border-line text-muted dark:border-zinc-700 dark:text-zinc-400',
                      ]}
                    >
                      {statusLabel(resource)}
                    </span>
                  </div>
                  <a class="mt-3 block text-lg font-semibold tracking-tight text-ink transition-colors hover:text-accent dark:text-zinc-100 dark:hover:text-orange-300" href={detailPath(resource)}>
                    {resource.name}
                  </a>
                  <p class="mt-2 line-clamp-2 text-sm leading-6 text-muted dark:text-zinc-400">{resource.description}</p>
                  <div class="mt-4 flex items-center justify-between gap-3 text-xs text-muted dark:text-zinc-500">
                    <span>{resource.owner} · v{resource.latestVersion}</span>
                    <a class="font-semibold text-ink hover:text-accent dark:text-zinc-300 dark:hover:text-orange-300" href={detailPath(resource)}>View</a>
                  </div>
                </article>
              ))}
            </div>
            <div class="mt-6 hidden rounded-lg border border-line bg-panel p-6 dark:border-zinc-800 dark:bg-zinc-900" data-no-results hidden>
              <strong class="font-semibold text-ink dark:text-zinc-100">No matching resources.</strong>
              <p class="mt-2 text-sm text-muted dark:text-zinc-400">Change the search text or select a different resource type.</p>
            </div>
          </>
        )}
      </section>

      <button class="invisible pointer-events-none fixed inset-0 z-40 bg-ink/20 opacity-0 transition-opacity duration-200 motion-reduce:transition-none dark:bg-black/50" type="button" aria-label="Close change deck" data-deck-backdrop></button>
      <section class="invisible pointer-events-none fixed inset-y-0 right-0 z-40 flex w-full max-w-2xl translate-x-full flex-col overflow-y-auto border-l border-line bg-canvas p-5 shadow-2xl transition-transform duration-200 motion-reduce:transition-none dark:border-zinc-800 dark:bg-zinc-950 sm:p-6" data-change-review id="change-deck" aria-hidden="true" aria-labelledby="change-review-title" role="dialog" aria-modal="true">
        <div class="flex shrink-0 flex-wrap items-start justify-between gap-4 border-b border-line pb-5 dark:border-zinc-800">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Workspace</p>
            <h2 id="change-review-title" class="mt-2 text-xl font-semibold tracking-tight text-ink dark:text-zinc-100">Change deck</h2>
            <p class="mt-2 text-sm text-muted dark:text-zinc-400" data-plan-context>No pending changes.</p>
          </div>
          <button class="text-sm font-semibold text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-zinc-400 dark:hover:text-orange-300" type="button" data-close-review>Close</button>
        </div>

        <section class="shrink-0 border-b border-line py-5 dark:border-zinc-800" aria-labelledby="deck-selection-title">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 id="deck-selection-title" class="text-sm font-semibold text-ink dark:text-zinc-100">Selected resources</h3>
              <p class="mt-1 text-xs text-muted dark:text-zinc-400" data-selection-count>0 resources selected</p>
            </div>
            <button class="text-xs font-semibold text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-zinc-400 dark:hover:text-orange-300" type="button" data-clear-selection>Discard changes</button>
          </div>
          <div class="mt-4 grid gap-2" data-selection-list></div>
          <p class="mt-4 rounded-md border border-dashed border-line p-4 text-sm text-muted dark:border-zinc-700 dark:text-zinc-400" data-selection-empty>Select resources from the catalog to stage changes here.</p>
        </section>

        <div class="mt-5 shrink-0 grid gap-5 border-b border-line pb-5 dark:border-zinc-800">
          <fieldset>
            <legend class="mb-3 text-xs font-semibold text-muted dark:text-zinc-400">Harnesses</legend>
            <div class="grid gap-3 sm:grid-cols-3">
              <label class="flex items-center gap-2 text-sm text-ink dark:text-zinc-200"><input class="size-4 accent-accent" type="checkbox" value="claude-code" data-plan-harness checked />Claude Code</label>
              <label class="flex items-center gap-2 text-sm text-ink dark:text-zinc-200"><input class="size-4 accent-accent" type="checkbox" value="opencode" data-plan-harness />OpenCode</label>
              <label class="flex items-center gap-2 text-sm text-ink dark:text-zinc-200"><input class="size-4 accent-accent" type="checkbox" value="codex" data-plan-harness />Codex</label>
            </div>
          </fieldset>
          <label class="block" for="plan-scope">
            <span class="mb-3 block text-xs font-semibold text-muted dark:text-zinc-400">Scope</span>
            <select class="block min-h-10 w-full rounded-md border border-line bg-canvas px-3 text-sm text-ink outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100" id="plan-scope" data-plan-scope>
              <option value="project">This project</option>
              <option value="global">All projects</option>
            </select>
          </label>
          <button class="justify-self-start text-xs font-semibold text-accent transition-colors hover:text-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-50" type="button" data-generate-plan>Refresh preview</button>
        </div>

        <div class="mt-5 hidden" data-plan-output>
          <div class="grid grid-cols-3 divide-x divide-line border-y border-line py-4 dark:divide-zinc-800 dark:border-zinc-800">
            <div class="pr-4"><strong class="block text-xl font-semibold text-ink dark:text-zinc-100" data-plan-count="added">0</strong><span class="mt-1 block text-xs text-muted dark:text-zinc-500">Added</span></div>
            <div class="px-4"><strong class="block text-xl font-semibold text-ink dark:text-zinc-100" data-plan-count="modified">0</strong><span class="mt-1 block text-xs text-muted dark:text-zinc-500">Modified</span></div>
            <div class="pl-4"><strong class="block text-xl font-semibold text-ink dark:text-zinc-100" data-plan-count="removed">0</strong><span class="mt-1 block text-xs text-muted dark:text-zinc-500">Removed</span></div>
          </div>
          <div class="mt-5 space-y-6" data-plan-changes>
            <section class="hidden" data-plan-section="added" aria-labelledby="plan-added-title">
              <h3 id="plan-added-title" class="text-sm font-semibold text-ink dark:text-zinc-100">Added files</h3>
              <ul class="mt-3 space-y-2" data-plan-list="added"></ul>
            </section>
            <section class="hidden" data-plan-section="modified" aria-labelledby="plan-modified-title">
              <h3 id="plan-modified-title" class="text-sm font-semibold text-ink dark:text-zinc-100">Modified files</h3>
              <ul class="mt-3 space-y-2" data-plan-list="modified"></ul>
            </section>
            <section class="hidden" data-plan-section="removed" aria-labelledby="plan-removed-title">
              <h3 id="plan-removed-title" class="text-sm font-semibold text-ink dark:text-zinc-100">Removed files</h3>
              <ul class="mt-3 space-y-2" data-plan-list="removed"></ul>
            </section>
            <p class="hidden rounded-md border border-line bg-canvas p-4 text-sm text-muted dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-400" data-plan-empty>No file changes are needed for this selection.</p>
          </div>
          <div class="mt-5 hidden rounded-md border border-amber-200 bg-warning-soft p-4 text-sm text-warning dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-300" data-plan-conflicts role="alert"></div>
          <div class="mt-5 hidden rounded-md border border-amber-200 bg-warning-soft p-4 text-sm text-warning dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-300" data-plan-warnings></div>
          <label class="mt-5 hidden items-start gap-3 rounded-md border border-line p-4 text-sm text-ink dark:border-zinc-700 dark:text-zinc-200" data-plan-force-label>
            <input class="mt-0.5 size-4 accent-accent" type="checkbox" data-plan-force />
            <span><strong class="font-semibold">Allow overwrite or removal of locally changed files</strong><span class="mt-1 block text-xs text-muted dark:text-zinc-400">Use this only after checking the affected files.</span></span>
          </label>
          <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm text-muted dark:text-zinc-400" data-plan-status role="status"></p>
            <button class="inline-flex min-h-10 items-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-50" type="button" data-apply-plan disabled>Save changes</button>
          </div>
        </div>
      </section>

      <section class="mt-14 flex w-full flex-col gap-5 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between dark:border-zinc-800" aria-label="Submit a resource">
        <div>
          <p class="text-sm font-semibold text-ink dark:text-zinc-100">Share a resource</p>
          <p class="mt-1 text-sm text-muted dark:text-zinc-400">Prepare its entry file and submit a pull request for review.</p>
        </div>
        <div class="flex flex-wrap items-center justify-end gap-3 sm:flex-nowrap">
          <a class="inline-flex min-h-10 items-center whitespace-nowrap rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="/publish/">Publish resource</a>
          <code class="whitespace-nowrap rounded-md bg-ink px-3 py-2 font-mono text-xs text-white dark:bg-zinc-800 dark:text-zinc-200">aid submit ./resource</code>
        </div>
      </section>
    </main>

    <footer class="mx-auto flex w-full max-w-6xl flex-col gap-1 border-t border-line px-5 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8 dark:border-zinc-800 dark:text-zinc-500">
      <p>Backed by the production branch of the resources repository.</p>
      <p>Local-first prototype</p>
    </footer>

    <script>
      type Action = 'install' | 'uninstall';
      type Change = {
        path: string;
        action: 'added' | 'modified' | 'removed';
        resource: string;
        harness: string;
        scope: string;
        before?: string;
        after?: string;
      };
      type Plan = {
        changes: Change[];
        conflicts: string[];
        warnings: string[];
      };

      const apiBase = document.documentElement.dataset.apiUrl ?? 'http://127.0.0.1:4317';
      const search = document.querySelector<HTMLInputElement>('#resource-search');
      const type = document.querySelector<HTMLSelectElement>('#resource-type');
      const count = document.querySelector<HTMLElement>('[data-result-count]');
      const noResults = document.querySelector<HTMLElement>('[data-no-results]');
      const resources = Array.from(document.querySelectorAll<HTMLElement>('[data-resource]'));
      const openDeckButton = document.querySelector<HTMLButtonElement>('[data-open-deck]');
      const deckBackdrop = document.querySelector<HTMLButtonElement>('[data-deck-backdrop]');
      const deckCount = document.querySelector<HTMLElement>('[data-deck-count]');
      const selectionCount = document.querySelector<HTMLElement>('[data-selection-count]');
      const selectionList = document.querySelector<HTMLElement>('[data-selection-list]');
      const selectionEmpty = document.querySelector<HTMLElement>('[data-selection-empty]');
      const clearSelectionButton = document.querySelector<HTMLButtonElement>('[data-clear-selection]');
      const review = document.querySelector<HTMLElement>('[data-change-review]');
      const closeReview = document.querySelector<HTMLButtonElement>('[data-close-review]');
      const planContext = document.querySelector<HTMLElement>('[data-plan-context]');
      const planHarnesses = Array.from(document.querySelectorAll<HTMLInputElement>('[data-plan-harness]'));
      const planScope = document.querySelector<HTMLSelectElement>('[data-plan-scope]');
      const generatePlan = document.querySelector<HTMLButtonElement>('[data-generate-plan]');
      const planOutput = document.querySelector<HTMLElement>('[data-plan-output]');
      const planStatus = document.querySelector<HTMLElement>('[data-plan-status]');
      const applyPlan = document.querySelector<HTMLButtonElement>('[data-apply-plan]');
      const forceLabel = document.querySelector<HTMLElement>('[data-plan-force-label]');
      const forceInput = document.querySelector<HTMLInputElement>('[data-plan-force]');
      const actions = new Map<string, Action>();
      let currentOperations: Array<{ resource: string; action: Action; harnesses: string[]; scope: string }> = [];
      let currentPlan: Plan | null = null;
      let planTimer: ReturnType<typeof setTimeout> | undefined;
      let planRequest = 0;

      function setHidden(element: HTMLElement | null, hidden: boolean) {
        if (!element) return;
        element.hidden = hidden;
        element.classList.toggle('hidden', hidden);
      }

      function selectedResources(): HTMLElement[] {
        return resources.filter((resource) =>
          resource.querySelector<HTMLInputElement>('[data-resource-select]')?.checked,
        );
      }

      function setDeckOpen(open: boolean) {
        if (!review || !deckBackdrop) return;
        review.classList.toggle('invisible', !open);
        review.classList.toggle('pointer-events-none', !open);
        review.classList.toggle('translate-x-full', !open);
        deckBackdrop.classList.toggle('invisible', !open);
        deckBackdrop.classList.toggle('pointer-events-none', !open);
        deckBackdrop.classList.toggle('opacity-0', !open);
        review.setAttribute('aria-hidden', String(!open));
        openDeckButton?.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('overflow-hidden', open);
        if (open) closeReview?.focus();
      }

      function invalidatePlan(message = 'Select a resource to generate a preview.') {
        planRequest += 1;
        currentPlan = null;
        setHidden(planOutput, true);
        if (applyPlan) applyPlan.disabled = true;
        if (planStatus) planStatus.textContent = message;
      }

      function updateSelectionSummary(selected: HTMLElement[]) {
        const size = selected.length;
        if (deckCount) deckCount.textContent = String(size);
        if (selectionCount) selectionCount.textContent = `${size} resource${size === 1 ? '' : 's'} selected`;
        if (planContext) planContext.textContent = size === 0
          ? 'No pending changes.'
          : `${size} resource${size === 1 ? '' : 's'} staged. Review the file changes before saving.`;
        setHidden(selectionEmpty, size > 0);
      }

      function renderSelection() {
        const selected = selectedResources();
        updateSelectionSummary(selected);
        if (!selectionList) return;

        selectionList.replaceChildren();
        for (const resource of selected) {
          const id = resource.dataset.resourceId ?? '';
          if (!actions.has(id)) actions.set(id, 'install');

          const row = document.createElement('div');
          row.className = 'flex flex-col gap-2 rounded-md border border-line bg-panel px-3 py-3 dark:border-zinc-700 dark:bg-zinc-900';

          const top = document.createElement('div');
          top.className = 'flex items-start justify-between gap-3';
          const label = document.createElement('span');
          label.className = 'break-all font-mono text-xs text-ink dark:text-zinc-200';
          label.textContent = id;
          top.append(label);

          const remove = document.createElement('button');
          remove.className = 'shrink-0 text-xs font-semibold text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:text-zinc-500 dark:hover:text-orange-300';
          remove.type = 'button';
          remove.textContent = 'Remove';
          remove.setAttribute('aria-label', `Remove ${id} from the change deck`);
          remove.addEventListener('click', () => {
            const input = resource.querySelector<HTMLInputElement>('[data-resource-select]');
            if (input) input.checked = false;
            renderSelection();
          });
          top.append(remove);
          row.append(top);

          const action = document.createElement('select');
          action.className = 'min-h-9 w-full rounded-md border border-line bg-canvas px-2 text-xs font-medium text-ink outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-200';
          action.setAttribute('aria-label', `Action for ${id}`);
          action.innerHTML = '<option value="install">Install or update</option><option value="uninstall">Uninstall</option>';
          action.value = actions.get(id) ?? 'install';
          action.addEventListener('change', () => {
            actions.set(id, action.value as Action);
            invalidatePlan();
            schedulePlan();
          });
          row.append(action);
          selectionList.append(row);
        }
        invalidatePlan(selected.length === 0 ? 'Select a resource to generate a preview.' : 'Updating preview…');
        schedulePlan();
      }

      function collectOperations() {
        const harnesses = planHarnesses.filter((input) => input.checked).map((input) => input.value);
        const scope = planScope?.value ?? 'project';
        return {
          harnesses,
          operations: selectedResources().map((resource) => ({
            resource: resource.dataset.resourceId ?? '',
            action: actions.get(resource.dataset.resourceId ?? '') ?? 'install',
            harnesses,
            scope,
          })),
        };
      }

      function schedulePlan() {
        if (planTimer) clearTimeout(planTimer);
        if (selectedResources().length === 0) return;
        if (planHarnesses.every((input) => !input.checked)) {
          invalidatePlan('Select at least one harness.');
          return;
        }
        planTimer = setTimeout(() => void generateChanges(), 250);
      }

      async function generateChanges() {
        const requestId = ++planRequest;
        const requestData = collectOperations();
        if (requestData.harnesses.length === 0 || requestData.operations.length === 0) return;
        currentOperations = requestData.operations;
        if (generatePlan) generatePlan.disabled = true;
        setHidden(planOutput, true);
        if (planStatus) planStatus.textContent = 'Updating preview…';
        try {
          const result = await request('/api/plan', { operations: currentOperations });
          if (requestId !== planRequest) return;
          renderPlan(result as Plan);
        } catch (error) {
          if (requestId === planRequest && planStatus) {
            planStatus.textContent = error instanceof Error ? error.message : 'Could not generate the change plan.';
          }
        } finally {
          if (requestId === planRequest && generatePlan) generatePlan.disabled = false;
        }
      }

      function appendChange(list: HTMLElement, change: Change) {
        const item = document.createElement('li');
        item.className = 'rounded-md border border-line bg-canvas p-3 dark:border-zinc-800 dark:bg-zinc-950';

        const header = document.createElement('div');
        header.className = 'flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between';
        const path = document.createElement('span');
        path.className = 'break-all font-mono text-xs font-semibold text-ink dark:text-zinc-200';
        path.textContent = change.path;
        const meta = document.createElement('span');
        meta.className = 'text-xs text-muted dark:text-zinc-500';
        meta.textContent = `${change.resource} · ${change.harness} · ${change.scope}`;
        header.append(path, meta);
        item.append(header);

        const content = change.after ?? change.before;
        if (content) {
          const details = document.createElement('details');
          details.className = 'mt-3 border-t border-line pt-3 dark:border-zinc-800';
          const summary = document.createElement('summary');
          summary.className = 'cursor-pointer text-xs font-semibold text-accent';
          summary.textContent = change.action === 'modified' ? 'View file change' : 'View file content';
          const pre = document.createElement('pre');
          pre.className = 'mt-3 max-h-64 overflow-auto rounded-md bg-ink p-3 font-mono text-xs leading-5 text-zinc-100 dark:bg-zinc-900';
          pre.textContent = change.action === 'modified'
            ? `Before:\n${change.before ?? '(file did not exist)'}\n\nAfter:\n${change.after ?? '(file will be removed)'}`
            : content;
          details.append(summary, pre);
          item.append(details);
        }
        list.append(item);
      }

      function renderPlan(plan: Plan) {
        currentPlan = plan;
        setHidden(planOutput, false);
        for (const action of ['added', 'modified', 'removed'] as const) {
          const changes = plan.changes.filter((change) => change.action === action);
          const section = document.querySelector<HTMLElement>(`[data-plan-section="${action}"]`);
          const list = document.querySelector<HTMLElement>(`[data-plan-list="${action}"]`);
          const total = document.querySelector<HTMLElement>(`[data-plan-count="${action}"]`);
          if (total) total.textContent = String(changes.length);
          setHidden(section, changes.length === 0);
          if (list) {
            list.replaceChildren();
            for (const change of changes) appendChange(list, change);
          }
        }

        setHidden(document.querySelector<HTMLElement>('[data-plan-empty]'), plan.changes.length !== 0);
        const conflicts = document.querySelector<HTMLElement>('[data-plan-conflicts]');
        if (conflicts) {
          conflicts.replaceChildren();
          if (plan.conflicts.length > 0) {
            const title = document.createElement('strong');
            title.className = 'font-semibold';
            title.textContent = 'Review required before applying.';
            const list = document.createElement('ul');
            list.className = 'mt-2 list-disc space-y-1 pl-5 text-xs';
            for (const conflict of plan.conflicts) {
              const item = document.createElement('li');
              item.textContent = conflict;
              list.append(item);
            }
            conflicts.append(title, list);
          }
          setHidden(conflicts, plan.conflicts.length === 0);
        }

        const warnings = document.querySelector<HTMLElement>('[data-plan-warnings]');
        if (warnings) {
          warnings.textContent = plan.warnings.length > 0
            ? `Unreviewed resources: ${plan.warnings.join(', ')}`
            : '';
          setHidden(warnings, plan.warnings.length === 0);
        }

        setHidden(forceLabel, plan.conflicts.length === 0);
        if (forceInput) forceInput.checked = false;
        if (applyPlan) applyPlan.disabled = plan.conflicts.length > 0 || plan.changes.length === 0;
        if (planStatus) {
          planStatus.textContent = plan.changes.length === 0
            ? 'No changes are needed.'
            : `${plan.changes.length} file${plan.changes.length === 1 ? '' : 's'} ready to apply.`;
        }
      }

      async function request(path: string, body: unknown) {
        const response = await fetch(`${apiBase}${path}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error ?? 'The local API request failed.');
        return result;
      }

      function updateResults() {
        const query = search?.value.toLowerCase().trim() ?? '';
        const selectedType = type?.value ?? 'all';
        let visible = 0;

        for (const resource of resources) {
          const matchesQuery = resource.dataset.search?.includes(query) ?? false;
          const matchesType = selectedType === 'all' || resource.dataset.type === selectedType;
          const hidden = !(matchesQuery && matchesType);
          resource.hidden = hidden;
          resource.classList.toggle('hidden', hidden);
          if (!hidden) visible += 1;
        }

        if (count) count.textContent = `${visible} result${visible === 1 ? '' : 's'}`;
        if (noResults) {
          noResults.hidden = visible !== 0;
          noResults.classList.toggle('hidden', visible !== 0);
        }
      }

      for (const resource of resources) {
        resource.querySelector<HTMLInputElement>('[data-resource-select]')?.addEventListener('change', renderSelection);
      }
      search?.addEventListener('input', updateResults);
      type?.addEventListener('change', updateResults);
      openDeckButton?.addEventListener('click', () => {
        setDeckOpen(true);
        if (selectedResources().length > 0 && !currentPlan) schedulePlan();
      });
      closeReview?.addEventListener('click', () => setDeckOpen(false));
      deckBackdrop?.addEventListener('click', () => setDeckOpen(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && review?.getAttribute('aria-hidden') === 'false') setDeckOpen(false);
      });
      clearSelectionButton?.addEventListener('click', () => {
        for (const resource of resources) {
          const input = resource.querySelector<HTMLInputElement>('[data-resource-select]');
          if (input) input.checked = false;
        }
        actions.clear();
        renderSelection();
      });
      for (const input of planHarnesses) input.addEventListener('change', () => {
        invalidatePlan('Updating preview…');
        schedulePlan();
      });
      planScope?.addEventListener('change', () => {
        invalidatePlan('Updating preview…');
        schedulePlan();
      });
      forceInput?.addEventListener('change', () => {
        if (applyPlan && currentPlan) applyPlan.disabled = currentPlan.changes.length === 0 || (currentPlan.conflicts.length > 0 && !forceInput.checked);
      });
      generatePlan?.addEventListener('click', () => void generateChanges());
      applyPlan?.addEventListener('click', async () => {
        if (currentOperations.length === 0) return;
        const force = forceInput?.checked === true;
        if (currentPlan?.conflicts.length && !force) return;
        applyPlan.disabled = true;
        if (planStatus) planStatus.textContent = 'Applying all changes…';
        try {
          const result = await request('/api/apply', { operations: currentOperations, force });
          if (planStatus) planStatus.textContent = `Applied ${result.plan.changes.length} file change${result.plan.changes.length === 1 ? '' : 's'}.`;
          for (const resource of resources) {
            const input = resource.querySelector<HTMLInputElement>('[data-resource-select]');
            if (input) input.checked = false;
          }
          actions.clear();
          currentOperations = [];
          renderSelection();
          if (planStatus) planStatus.textContent = `Saved ${result.plan.changes.length} file change${result.plan.changes.length === 1 ? '' : 's'}.`;
        } catch (error) {
          if (planStatus) planStatus.textContent = error instanceof Error ? error.message : 'Could not apply the change plan.';
          applyPlan.disabled = false;
        }
      });
      renderSelection();
    </script>
  </body>
</html>
