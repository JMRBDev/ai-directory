---
import type { ResourceSummary } from '@ai-directory/contracts';
import { loadRegistry, refreshRegistry, resourceId } from '../lib/registry';
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SettingsDrawer from '../components/SettingsDrawer.astro';
import '../styles/global.css';

if (Astro.url.searchParams.get('refresh') === '1') await refreshRegistry();
const registry = await loadRegistry();
const resources = (registry.index?.resources ?? [])
  .filter((resource) => resource.lifecycleStatus === 'active')
  .sort((left, right) => resourceId(left).localeCompare(resourceId(right)));
const reviewedCount = resources.filter((resource) => resource.reviewStatus === 'reviewed').length;
const resourceTypes = new Set(resources.map((resource) => resource.type)).size;
const title = 'AI Directory | Internal resource registry';
const apiUrl = import.meta.env.PUBLIC_AI_DIRECTORY_API_URL ?? 'http://127.0.0.1:4317';

function detailPath(resource: ResourceSummary): string {
  return `/resources/${resource.owner}/${resource.type}/${resource.name}/`;
}

function statusLabel(resource: ResourceSummary): string {
  return resource.reviewStatus === 'reviewed' ? 'Reviewed' : 'Unreviewed';
}
---

<!doctype html>
<html lang="en" data-api-url={apiUrl}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Internal catalog of reusable AI development resources."
    />
    <ThemeInit />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased">
    <a
      class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50"
      href="#catalog"
    >Skip to catalog</a>
    <SiteHeader showChanges showPublish showRefresh showSettings />

    <main class="mx-auto w-full max-w-6xl px-5 py-10 sm:px-8 lg:py-14">
      <section class="hero w-full justify-start" aria-labelledby="page-title">
        <div class="hero-content block w-full max-w-none p-0">
          <h1 id="page-title" class="max-w-2xl text-3xl font-semibold tracking-tight text-base-content sm:text-4xl">
            Find a resource for the work in front of you.
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-7 text-base-content/60">
            Shared skills, agents, rules, and templates. Read the source, check the review status, and
            install what you need locally.
          </p>
          <div class="stats stats-vertical mt-8 w-full border-y border-base-300 sm:stats-horizontal" aria-label="Registry summary">
            <div class="stat px-0 py-4 sm:pr-6">
              <div class="stat-value text-2xl">{resources.length}</div>
              <div class="stat-title mt-1 text-xs text-base-content/60">Active</div>
            </div>
            <div class="stat border-base-300 px-0 py-4 sm:border-l sm:px-6">
              <div class="stat-value text-2xl">{reviewedCount}</div>
              <div class="stat-title mt-1 text-xs text-base-content/60">Reviewed</div>
            </div>
            <div class="stat border-base-300 px-0 py-4 sm:border-l sm:pl-6">
              <div class="stat-value text-2xl">{resourceTypes}</div>
              <div class="stat-title mt-1 text-xs text-base-content/60">Types</div>
            </div>
          </div>
        </div>
      </section>

      <section id="catalog" class="mt-14" aria-labelledby="catalog-title">
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-base-300 pb-5">
          <div>
            <h2 id="catalog-title" class="text-xl font-semibold tracking-tight text-base-content">Available resources</h2>
          </div>
          <p class="text-xs text-base-content/60">
            Source: {registry.source === 'remote' ? 'configured Git registry' : 'explicit local index'}
          </p>
        </div>

        {registry.error ? (
          <div class="alert alert-error mt-6 items-start text-sm" role="alert">
            <i class="ph ph-warning-circle text-xl" aria-hidden="true"></i>
            <div>
              <strong class="font-semibold">Could not load the registry.</strong>
              <p class="mt-2">{registry.error}</p>
              <p class="mt-2">Run <kbd class="kbd kbd-sm font-mono">aid setup</kbd> or pass <kbd class="kbd kbd-sm font-mono">--index &lt;path&gt;</kbd>.</p>
            </div>
          </div>
        ) : resources.length === 0 ? (
          <div class="card mt-6 border border-base-300 bg-base-100">
            <div class="card-body p-6">
              <strong class="font-semibold text-base-content">No active resources yet.</strong>
              <p class="mt-2 text-sm text-base-content/60">Submit the first resource with the CLI, then refresh the registry.</p>
            </div>
          </div>
        ) : (
          <>
            <div class="card mt-6 border border-base-300 bg-base-100" role="search">
              <div class="card-body grid gap-4 p-4 sm:grid-cols-[minmax(0,1fr)_12rem_auto] sm:items-end">
              <label class="fieldset">
                <span class="fieldset-legend">Search</span>
                <input
                  class="input input-bordered w-full"
                  id="resource-search" type="search" placeholder="Name, owner, or description" autocomplete="off"
                />
              </label>
              <label class="fieldset">
                <span class="fieldset-legend">Type</span>
                <select class="select select-bordered w-full" id="resource-type">
                  <option value="all">All types</option>
                  <option value="skills">Skills</option>
                  <option value="agents">Agents</option>
                  <option value="rules">Rules</option>
                  <option value="templates">Templates</option>
                </select>
              </label>
              <p class="pb-2 text-xs text-base-content/60" aria-live="polite" data-result-count>
                {resources.length} results
              </p>
              </div>
            </div>

            <div class="mt-4 grid gap-4 md:grid-cols-2" data-resource-grid>
              {resources.map((resource) => (
                <article
                  class="card card-border bg-base-100"
                  data-resource
                  data-type={resource.type}
                  data-resource-id={resourceId(resource)}
                  data-search={`${resourceId(resource)} ${resource.description}`.toLowerCase()}
                >
                  <div class="card-body gap-3 p-5">
                    <div class="flex items-center justify-between gap-3 text-xs">
                      <label class="label cursor-pointer justify-start gap-2 p-0 text-base-content/60">
                        <input class="checkbox checkbox-sm" type="checkbox" data-resource-select aria-label={`Select ${resource.name}`} />
                        <span class="font-semibold uppercase tracking-[0.12em] text-primary">{resource.type}</span>
                      </label>
                      <span
                        class:list={[
                          'badge',
                          resource.reviewStatus === 'unreviewed'
                            ? 'badge-warning'
                            : 'badge-success',
                        ]}
                      >
                        {statusLabel(resource)}
                      </span>
                    </div>
                    <h3 class="card-title text-lg">
                      <a class="link link-hover" href={detailPath(resource)}>{resource.name}</a>
                    </h3>
                    <p class="line-clamp-2 text-sm leading-6 text-base-content/60">{resource.description}</p>
                    <div class="card-actions mt-1 items-center justify-between text-xs text-base-content/60">
                      <span>{resource.owner} · v{resource.latestVersion}</span>
                      <a class="btn btn-ghost btn-xs" href={detailPath(resource)}>View</a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
            <div class="card mt-6 hidden border border-base-300 bg-base-100" data-no-results hidden>
              <div class="card-body p-6">
                <strong class="font-semibold text-base-content">No matching resources.</strong>
                <p class="mt-2 text-sm text-base-content/60">Change the search text or select a different resource type.</p>
              </div>
            </div>
          </>
        )}
      </section>

      <div class="drawer drawer-end pointer-events-none fixed inset-0 z-40" data-deck-root>
        <input class="drawer-toggle" id="change-deck-toggle" type="checkbox" data-deck-toggle aria-hidden="true" tabindex="-1" />
        <div class="drawer-content pointer-events-none" aria-hidden="true"></div>
        <div class="drawer-side">
          <label class="drawer-overlay bg-neutral/30" for="change-deck-toggle" aria-label="Close change deck" data-deck-backdrop></label>
          <section class="card card-border min-h-full w-full max-w-2xl overflow-y-auto rounded-none bg-base-100 text-base-content shadow-2xl" data-change-review id="change-deck" aria-hidden="true" aria-labelledby="change-review-title" role="dialog" aria-modal="true">
        <div class="card-body min-h-full overflow-y-auto p-5 sm:p-6">
        <div class="flex shrink-0 flex-wrap items-start justify-between gap-4 border-b border-base-300 pb-5">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Workspace</p>
            <h2 id="change-review-title" class="mt-2 text-xl font-semibold tracking-tight text-base-content">Change deck</h2>
            <p class="mt-2 text-sm text-base-content/60" data-plan-context>No pending changes.</p>
          </div>
          <button class="btn btn-ghost btn-sm" type="button" data-close-review>Close</button>
        </div>

        <section class="shrink-0 border-b border-base-300 py-5" aria-labelledby="deck-selection-title">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 id="deck-selection-title" class="text-sm font-semibold text-base-content">Selected resources</h3>
              <p class="mt-1 text-xs text-base-content/60" data-selection-count>0 resources selected</p>
            </div>
            <button class="btn btn-ghost btn-xs" type="button" data-clear-selection>Discard changes</button>
          </div>
          <ul class="list list-sm mt-4" data-selection-list></ul>
          <div class="alert alert-info mt-4 items-start text-sm" data-selection-empty>
            <i class="ph ph-info text-lg" aria-hidden="true"></i>
            <span>Select resources from the catalog to stage changes here.</span>
          </div>
          </section>

        <div class="mt-5 grid shrink-0 gap-5 border-b border-base-300 pb-5">
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Harnesses</legend>
            <div class="grid gap-3 sm:grid-cols-3">
              <label class="label cursor-pointer justify-start gap-2"><input class="checkbox checkbox-primary" type="checkbox" value="claude-code" data-plan-harness checked />Claude Code</label>
              <label class="label cursor-pointer justify-start gap-2"><input class="checkbox checkbox-primary" type="checkbox" value="opencode" data-plan-harness />OpenCode</label>
              <label class="label cursor-pointer justify-start gap-2"><input class="checkbox checkbox-primary" type="checkbox" value="codex" data-plan-harness />Codex</label>
            </div>
          </fieldset>
          <label class="fieldset" for="plan-scope">
            <span class="fieldset-legend">Scope</span>
            <select class="select select-bordered w-full" id="plan-scope" data-plan-scope>
              <option value="project">This project</option>
              <option value="global">All projects</option>
            </select>
          </label>
          <button class="btn btn-ghost btn-sm justify-self-start text-primary" type="button" data-generate-plan>Refresh preview</button>
        </div>

        <div class="card card-border mt-5 hidden bg-base-100" data-plan-output>
          <div class="card-body p-0">
            <div class="stats stats-vertical w-full sm:stats-horizontal">
              <div class="stat px-5 py-4 sm:pr-4"><div class="stat-value text-xl" data-plan-count="added">0</div><div class="stat-title text-xs">Added</div></div>
              <div class="stat border-base-300 px-5 py-4 sm:border-l sm:px-4"><div class="stat-value text-xl" data-plan-count="modified">0</div><div class="stat-title text-xs">Modified</div></div>
              <div class="stat border-base-300 px-5 py-4 sm:border-l sm:pl-4"><div class="stat-value text-xl" data-plan-count="removed">0</div><div class="stat-title text-xs">Removed</div></div>
            </div>
          <div class="space-y-6 p-5" data-plan-changes>
            <section class="hidden" data-plan-section="added" aria-labelledby="plan-added-title">
              <h3 id="plan-added-title" class="text-sm font-semibold text-base-content">Added files</h3>
              <ul class="list list-sm mt-3" data-plan-list="added"></ul>
            </section>
            <section class="hidden" data-plan-section="modified" aria-labelledby="plan-modified-title">
              <h3 id="plan-modified-title" class="text-sm font-semibold text-base-content">Modified files</h3>
              <ul class="list list-sm mt-3" data-plan-list="modified"></ul>
            </section>
            <section class="hidden" data-plan-section="removed" aria-labelledby="plan-removed-title">
              <h3 id="plan-removed-title" class="text-sm font-semibold text-base-content">Removed files</h3>
              <ul class="list list-sm mt-3" data-plan-list="removed"></ul>
            </section>
            <div class="alert alert-info hidden items-start text-sm" data-plan-empty>
              <i class="ph ph-info text-lg" aria-hidden="true"></i>
              <span>No file changes are needed for this selection.</span>
            </div>
          </div>
          <div class="alert alert-warning mx-5 mt-5 hidden items-start text-sm" data-plan-conflicts role="alert"></div>
          <div class="alert alert-warning mx-5 mt-5 hidden items-start text-sm" data-plan-warnings></div>
          <label class="alert alert-warning mx-5 mt-5 hidden items-start gap-3 text-sm" data-plan-force-label>
            <input class="checkbox checkbox-warning mt-0.5" type="checkbox" data-plan-force />
            <span><strong class="font-semibold">Allow overwrite or removal of locally changed files</strong><span class="mt-1 block text-xs">Use this only after checking the affected files.</span></span>
          </label>
          <div class="mt-5 flex flex-wrap items-center justify-between gap-3 px-5 pb-5">
            <p class="text-sm text-base-content/60" data-plan-status role="status"></p>
            <button class="btn btn-primary" type="button" data-apply-plan disabled>Save changes</button>
          </div>
          </div>
          </div>
        </div>
          </section>
        </div>
      </div>

      <section class="card card-border mt-14 w-full bg-base-100 sm:card-side" aria-label="Submit a resource">
        <div class="card-body gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-semibold text-base-content">Share a resource</p>
            <p class="mt-1 text-sm text-base-content/60">Prepare its entry file and submit a pull request for review.</p>
          </div>
          <div class="card-actions items-center sm:justify-end">
            <a class="btn btn-primary whitespace-nowrap" href="/publish/">Publish resource</a>
            <kbd class="kbd kbd-sm whitespace-nowrap font-mono">aid submit ./resource</kbd>
          </div>
        </div>
      </section>
    </main>

    <SettingsDrawer />

    <footer class="footer mx-auto w-full max-w-6xl border-t border-base-300 px-5 py-6 text-xs text-base-content/60 sm:px-8">
      <p>Backed by the production branch of the resources repository.</p>
      <p>Local-first prototype</p>
    </footer>

    <script>
      type Action = 'install' | 'uninstall';
      type Change = {
        path: string;
        action: 'added' | 'modified' | 'removed';
        resource: string;
        harness: string;
        scope: string;
        before?: string;
        after?: string;
      };
      type Plan = {
        changes: Change[];
        conflicts: string[];
        warnings: string[];
      };

      const apiBase = document.documentElement.dataset.apiUrl ?? 'http://127.0.0.1:4317';
      const search = document.querySelector<HTMLInputElement>('#resource-search');
      const type = document.querySelector<HTMLSelectElement>('#resource-type');
      const count = document.querySelector<HTMLElement>('[data-result-count]');
      const noResults = document.querySelector<HTMLElement>('[data-no-results]');
      const resources = Array.from(document.querySelectorAll<HTMLElement>('[data-resource]'));
      const openDeckButton = document.querySelector<HTMLButtonElement>('[data-open-deck]');
      const deckBackdrop = document.querySelector<HTMLElement>('[data-deck-backdrop]');
      const deckRoot = document.querySelector<HTMLElement>('[data-deck-root]');
      const deckToggle = document.querySelector<HTMLInputElement>('[data-deck-toggle]');
      const deckSide = deckRoot?.querySelector<HTMLElement>('.drawer-side');
      const deckCount = document.querySelector<HTMLElement>('[data-deck-count]');
      const selectionCount = document.querySelector<HTMLElement>('[data-selection-count]');
      const selectionList = document.querySelector<HTMLElement>('[data-selection-list]');
      const selectionEmpty = document.querySelector<HTMLElement>('[data-selection-empty]');
      const clearSelectionButton = document.querySelector<HTMLButtonElement>('[data-clear-selection]');
      const review = document.querySelector<HTMLElement>('[data-change-review]');
      const closeReview = document.querySelector<HTMLButtonElement>('[data-close-review]');
      const planContext = document.querySelector<HTMLElement>('[data-plan-context]');
      const planHarnesses = Array.from(document.querySelectorAll<HTMLInputElement>('[data-plan-harness]'));
      const planScope = document.querySelector<HTMLSelectElement>('[data-plan-scope]');
      const generatePlan = document.querySelector<HTMLButtonElement>('[data-generate-plan]');
      const planOutput = document.querySelector<HTMLElement>('[data-plan-output]');
      const planStatus = document.querySelector<HTMLElement>('[data-plan-status]');
      const applyPlan = document.querySelector<HTMLButtonElement>('[data-apply-plan]');
      const forceLabel = document.querySelector<HTMLElement>('[data-plan-force-label]');
      const forceInput = document.querySelector<HTMLInputElement>('[data-plan-force]');
      const actions = new Map<string, Action>();
      let currentOperations: Array<{ resource: string; action: Action; harnesses: string[]; scope: string }> = [];
      let currentPlan: Plan | null = null;
      let planTimer: ReturnType<typeof setTimeout> | undefined;
      let planRequest = 0;

      function setHidden(element: HTMLElement | null, hidden: boolean) {
        if (!element) return;
        element.hidden = hidden;
        element.classList.toggle('hidden', hidden);
      }

      function selectedResources(): HTMLElement[] {
        return resources.filter((resource) =>
          resource.querySelector<HTMLInputElement>('[data-resource-select]')?.checked,
        );
      }

      function setDeckOpen(open: boolean) {
        if (!review || !deckBackdrop || !deckRoot || !deckToggle) return;
        deckRoot.classList.toggle('drawer-open', open);
        deckRoot.classList.toggle('pointer-events-none', !open);
        deckToggle.checked = open;
        deckSide?.style.setProperty('display', open ? 'grid' : 'none', 'important');
        deckSide?.style.setProperty('visibility', open ? 'visible' : 'hidden', 'important');
        deckSide?.style.setProperty('opacity', open ? '1' : '0', 'important');
        deckSide?.style.setProperty('transition', 'none', 'important');
        review.style.setProperty('transform', `translateX(${open ? '0' : '100'}%)`, 'important');
        review.style.setProperty('translate', open ? '0%' : '100%', 'important');
        review.style.setProperty('transition', 'none', 'important');
        review.setAttribute('aria-hidden', String(!open));
        openDeckButton?.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('overflow-hidden', open);
        if (open) closeReview?.focus();
      }

      function invalidatePlan(message = 'Select a resource to generate a preview.') {
        planRequest += 1;
        currentPlan = null;
        setHidden(planOutput, true);
        if (applyPlan) applyPlan.disabled = true;
        if (planStatus) planStatus.textContent = message;
      }

      function updateSelectionSummary(selected: HTMLElement[]) {
        const size = selected.length;
        if (deckCount) deckCount.textContent = String(size);
        if (selectionCount) selectionCount.textContent = `${size} resource${size === 1 ? '' : 's'} selected`;
        if (planContext) planContext.textContent = size === 0
          ? 'No pending changes.'
          : `${size} resource${size === 1 ? '' : 's'} staged. Review the file changes before saving.`;
        setHidden(selectionEmpty, size > 0);
      }

      function renderSelection() {
        const selected = selectedResources();
        updateSelectionSummary(selected);
        if (!selectionList) return;

        selectionList.replaceChildren();
        for (const resource of selected) {
          const id = resource.dataset.resourceId ?? '';
          if (!actions.has(id)) actions.set(id, 'install');

          const row = document.createElement('li');
          row.className = 'list-row list-col-wrap grid-cols-1 gap-2 bg-base-200';

          const top = document.createElement('div');
          top.className = 'flex items-start justify-between gap-3';
          const label = document.createElement('span');
          label.className = 'break-all font-mono text-xs text-base-content';
          label.textContent = id;
          top.append(label);

          const remove = document.createElement('button');
          remove.className = 'btn btn-ghost btn-xs shrink-0';
          remove.type = 'button';
          remove.textContent = 'Remove';
          remove.setAttribute('aria-label', `Remove ${id} from the change deck`);
          remove.addEventListener('click', () => {
            const input = resource.querySelector<HTMLInputElement>('[data-resource-select]');
            if (input) input.checked = false;
            renderSelection();
          });
          top.append(remove);
          const body = document.createElement('div');
          body.className = 'list-col-grow flex flex-col gap-2';
          body.append(top);

          const action = document.createElement('select');
          action.className = 'select select-bordered select-sm w-full';
          action.setAttribute('aria-label', `Action for ${id}`);
          action.innerHTML = '<option value="install">Install or update</option><option value="uninstall">Uninstall</option>';
          action.value = actions.get(id) ?? 'install';
          action.addEventListener('change', () => {
            actions.set(id, action.value as Action);
            invalidatePlan();
            schedulePlan();
          });
          body.append(action);
          row.append(body);
          selectionList.append(row);
        }
        invalidatePlan(selected.length === 0 ? 'Select a resource to generate a preview.' : 'Updating preview…');
        schedulePlan();
      }

      function collectOperations() {
        const harnesses = planHarnesses.filter((input) => input.checked).map((input) => input.value);
        const scope = planScope?.value ?? 'project';
        return {
          harnesses,
          operations: selectedResources().map((resource) => ({
            resource: resource.dataset.resourceId ?? '',
            action: actions.get(resource.dataset.resourceId ?? '') ?? 'install',
            harnesses,
            scope,
          })),
        };
      }

      function schedulePlan() {
        if (planTimer) clearTimeout(planTimer);
        if (selectedResources().length === 0) return;
        if (planHarnesses.every((input) => !input.checked)) {
          invalidatePlan('Select at least one harness.');
          return;
        }
        planTimer = setTimeout(() => void generateChanges(), 250);
      }

      async function generateChanges() {
        const requestId = ++planRequest;
        const requestData = collectOperations();
        if (requestData.harnesses.length === 0 || requestData.operations.length === 0) return;
        currentOperations = requestData.operations;
        if (generatePlan) generatePlan.disabled = true;
        setHidden(planOutput, true);
        if (planStatus) planStatus.textContent = 'Updating preview…';
        try {
          const result = await request('/api/plan', { operations: currentOperations });
          if (requestId !== planRequest) return;
          renderPlan(result as Plan);
        } catch (error) {
          if (requestId === planRequest && planStatus) {
            planStatus.textContent = error instanceof Error ? error.message : 'Could not generate the change plan.';
          }
        } finally {
          if (requestId === planRequest && generatePlan) generatePlan.disabled = false;
        }
      }

      function appendChange(list: HTMLElement, change: Change) {
        const item = document.createElement('li');
        item.className = 'list-row list-col-wrap gap-3 bg-base-200';

        const header = document.createElement('div');
        header.className = 'flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between';
        const path = document.createElement('span');
        path.className = 'break-all font-mono text-xs font-semibold text-base-content';
        path.textContent = change.path;
        const meta = document.createElement('span');
        meta.className = 'text-xs text-base-content/60';
        meta.textContent = `${change.resource} · ${change.harness} · ${change.scope}`;
        header.append(path, meta);
        const body = document.createElement('div');
        body.className = 'list-col-grow';
        body.append(header);

        const content = change.after ?? change.before;
        if (content) {
          const details = document.createElement('details');
          details.className = 'collapse collapse-arrow mt-3 border border-base-300';
          const summary = document.createElement('summary');
          summary.className = 'collapse-title min-h-0 py-3 text-xs font-semibold text-primary';
          summary.textContent = change.action === 'modified' ? 'View file change' : 'View file content';
          const contentContainer = document.createElement('div');
          contentContainer.className = 'collapse-content';
          const codeBlock = document.createElement('div');
          codeBlock.className = 'mockup-code max-h-64 overflow-auto text-xs leading-5 before:hidden';
          const pre = document.createElement('pre');
          const code = document.createElement('code');
          code.textContent = change.action === 'modified'
            ? `Before:\n${change.before ?? '(file did not exist)'}\n\nAfter:\n${change.after ?? '(file will be removed)'}`
            : content;
          pre.append(code);
          codeBlock.append(pre);
          contentContainer.append(codeBlock);
          details.append(summary, contentContainer);
          body.append(details);
        }
        item.append(body);
        list.append(item);
      }

      function renderPlan(plan: Plan) {
        currentPlan = plan;
        setHidden(planOutput, false);
        for (const action of ['added', 'modified', 'removed'] as const) {
          const changes = plan.changes.filter((change) => change.action === action);
          const section = document.querySelector<HTMLElement>(`[data-plan-section="${action}"]`);
          const list = document.querySelector<HTMLElement>(`[data-plan-list="${action}"]`);
          const total = document.querySelector<HTMLElement>(`[data-plan-count="${action}"]`);
          if (total) total.textContent = String(changes.length);
          setHidden(section, changes.length === 0);
          if (list) {
            list.replaceChildren();
            for (const change of changes) appendChange(list, change);
          }
        }

        setHidden(document.querySelector<HTMLElement>('[data-plan-empty]'), plan.changes.length !== 0);
        const conflicts = document.querySelector<HTMLElement>('[data-plan-conflicts]');
        if (conflicts) {
          conflicts.replaceChildren();
          if (plan.conflicts.length > 0) {
            const title = document.createElement('strong');
            title.className = 'font-semibold';
            title.textContent = 'Review required before applying.';
            const list = document.createElement('ul');
            list.className = 'list list-xs mt-2';
            for (const conflict of plan.conflicts) {
              const item = document.createElement('li');
              item.className = 'list-row py-1';
              item.textContent = conflict;
              list.append(item);
            }
            conflicts.append(title, list);
          }
          setHidden(conflicts, plan.conflicts.length === 0);
        }

        const warnings = document.querySelector<HTMLElement>('[data-plan-warnings]');
        if (warnings) {
          warnings.textContent = plan.warnings.length > 0
            ? `Unreviewed resources: ${plan.warnings.join(', ')}`
            : '';
          setHidden(warnings, plan.warnings.length === 0);
        }

        setHidden(forceLabel, plan.conflicts.length === 0);
        if (forceInput) forceInput.checked = false;
        if (applyPlan) applyPlan.disabled = plan.conflicts.length > 0 || plan.changes.length === 0;
        if (planStatus) {
          planStatus.textContent = plan.changes.length === 0
            ? 'No changes are needed.'
            : `${plan.changes.length} file${plan.changes.length === 1 ? '' : 's'} ready to apply.`;
        }
      }

      async function request(path: string, body: unknown) {
        const response = await fetch(`${apiBase}${path}`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error ?? 'The local API request failed.');
        return result;
      }

      function updateResults() {
        const query = search?.value.toLowerCase().trim() ?? '';
        const selectedType = type?.value ?? 'all';
        let visible = 0;

        for (const resource of resources) {
          const matchesQuery = resource.dataset.search?.includes(query) ?? false;
          const matchesType = selectedType === 'all' || resource.dataset.type === selectedType;
          const hidden = !(matchesQuery && matchesType);
          resource.hidden = hidden;
          resource.classList.toggle('hidden', hidden);
          if (!hidden) visible += 1;
        }

        if (count) count.textContent = `${visible} result${visible === 1 ? '' : 's'}`;
        if (noResults) {
          noResults.hidden = visible !== 0;
          noResults.classList.toggle('hidden', visible !== 0);
        }
      }

      for (const resource of resources) {
        resource.querySelector<HTMLInputElement>('[data-resource-select]')?.addEventListener('change', renderSelection);
      }
      search?.addEventListener('input', updateResults);
      type?.addEventListener('change', updateResults);
      openDeckButton?.addEventListener('click', () => {
        setDeckOpen(true);
        if (selectedResources().length > 0 && !currentPlan) schedulePlan();
      });
      closeReview?.addEventListener('click', () => setDeckOpen(false));
      deckBackdrop?.addEventListener('click', () => setDeckOpen(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && review?.getAttribute('aria-hidden') === 'false') setDeckOpen(false);
      });
      clearSelectionButton?.addEventListener('click', () => {
        for (const resource of resources) {
          const input = resource.querySelector<HTMLInputElement>('[data-resource-select]');
          if (input) input.checked = false;
        }
        actions.clear();
        renderSelection();
      });
      for (const input of planHarnesses) input.addEventListener('change', () => {
        invalidatePlan('Updating preview…');
        schedulePlan();
      });
      planScope?.addEventListener('change', () => {
        invalidatePlan('Updating preview…');
        schedulePlan();
      });
      forceInput?.addEventListener('change', () => {
        if (applyPlan && currentPlan) applyPlan.disabled = currentPlan.changes.length === 0 || (currentPlan.conflicts.length > 0 && !forceInput.checked);
      });
      generatePlan?.addEventListener('click', () => void generateChanges());
      applyPlan?.addEventListener('click', async () => {
        if (currentOperations.length === 0) return;
        const force = forceInput?.checked === true;
        if (currentPlan?.conflicts.length && !force) return;
        applyPlan.disabled = true;
        if (planStatus) planStatus.textContent = 'Applying all changes…';
        try {
          const result = await request('/api/apply', { operations: currentOperations, force });
          if (planStatus) planStatus.textContent = `Applied ${result.plan.changes.length} file change${result.plan.changes.length === 1 ? '' : 's'}.`;
          for (const resource of resources) {
            const input = resource.querySelector<HTMLInputElement>('[data-resource-select]');
            if (input) input.checked = false;
          }
          actions.clear();
          currentOperations = [];
          renderSelection();
          if (planStatus) planStatus.textContent = `Saved ${result.plan.changes.length} file change${result.plan.changes.length === 1 ? '' : 's'}.`;
        } catch (error) {
          if (planStatus) planStatus.textContent = error instanceof Error ? error.message : 'Could not apply the change plan.';
          applyPlan.disabled = false;
        }
      });
      renderSelection();
    </script>
  </body>
</html>
