---
import { homedir } from "node:os";
import { loadRegistry, refreshRegistry } from "../lib/registry";
import { resolveApiUrl } from "../lib/api";
import { resourceKey } from "@ai-directory/domain";
import ThemeInit from "../components/ThemeInit.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ChangeDeckProvider from "../components/preact/ChangeDeck";
import PublishForm from "../components/preact/PublishForm";
import SettingsDrawer from "../components/preact/SettingsDrawer";
import "../styles/global.css";

if (Astro.url.searchParams.get("refresh") === "1") await refreshRegistry();
const registry = await loadRegistry();
const resources = (registry.index?.resources ?? [])
  .filter((resource) => resource.lifecycleStatus === "active")
  .sort((left, right) => resourceKey(left).localeCompare(resourceKey(right)));
const apiUrl =
  import.meta.env.PUBLIC_AI_DIRECTORY_API_URL ?? resolveApiUrl(Astro.url.hostname);
const homeDir = homedir();

if (Astro.url.searchParams.get("refresh") === "1") {
  void fetch(apiUrl + "/api/refresh", { method: "POST" }).catch(() => undefined);
}
---

<!doctype html>
<html lang="en" data-api-url={apiUrl}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Internal catalog of reusable AI development resources."
    />
    <ThemeInit />
    <title>AI Directory | Internal resource registry</title>
  </head>
  <body
    class="min-h-screen bg-base-100 font-sans text-base-content antialiased flex flex-col gap-2"
  >
    <SiteHeader showChanges showInstalled showPublish showRefresh showSettings />

    <main class="mx-auto w-full max-w-6xl px-5 sm:px-8 flex-1">
      <ChangeDeckProvider
        client:load
        apiUrl={apiUrl}
        homeDir={homeDir}
        resources={resources}
        registryError={registry.error}
      />
    </main>

    <SettingsDrawer client:load apiUrl={apiUrl} />
    <PublishForm client:load apiUrl={apiUrl} />

    <footer
      class="flex justify-between items-center gap-3 footer mx-auto w-full max-w-6xl border-t border-base-300 px-5 py-6 text-xs text-base-content/60 sm:px-8"
    >
      <p>Backed by the production branch of the resources repository.</p>
      <p>Local-first prototype</p>
    </footer>
  </body>
</html>
