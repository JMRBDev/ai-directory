---
import type { ResourceSummary } from '@ai-directory/contracts';
import {
  loadRegistry,
  loadResource,
  resourceId,
  type RegistryView,
} from '../../../../lib/registry';
import ThemeInit from '../../../../components/ThemeInit.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import '../../../../styles/global.css';

type Props = {
  resource: ResourceSummary;
  version: Awaited<ReturnType<typeof loadResource>>['version'];
  componentResources: string[];
  source: RegistryView['source'];
  fileError?: string;
};

const requestedResourceId = [Astro.params.owner, Astro.params.type, Astro.params.name].join('/');
const registry = await loadRegistry();
const resource = registry.index?.resources.find(
  (candidate) =>
    candidate.lifecycleStatus === 'active' && resourceId(candidate) === requestedResourceId,
);

if (!resource) return Astro.redirect('/');

const result = await loadResource(registry.indexPath, resource, registry.repository);
const { version, componentResources, source, fileError } = {
  resource,
  version: result.version,
  componentResources: result.resources.map((item) => resourceId(item.resource)),
  source: registry.source,
  ...(result.error ? { fileError: result.error } : {}),
} satisfies Props;
const title = `${resource.name} | AI Directory`;
const installBase = `aid install ${resourceId(resource)} --harness claude-code`;
const apiUrl = import.meta.env.PUBLIC_AI_DIRECTORY_API_URL ?? 'http://127.0.0.1:4317';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={resource.description} />
    <ThemeInit />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased">
    <SiteHeader sourceLabel={source === 'remote' ? 'Configured Git registry' : 'Explicit local index'} />

    <main class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-8 lg:py-12">
      <a class="btn btn-ghost btn-sm -ml-3" href="/">Back to catalog</a>

      <section class="mt-10 max-w-3xl" aria-labelledby="resource-title">
        <div class="flex items-center gap-3 text-xs">
          <span class="font-semibold uppercase tracking-[0.12em] text-primary">{resource.type}</span>
          <span
            class:list={[
              'badge',
              resource.reviewStatus === 'unreviewed'
                ? 'badge-warning'
                : 'badge-ghost',
            ]}
          >
            {resource.reviewStatus === 'reviewed' ? 'Reviewed' : 'Unreviewed'}
          </span>
        </div>
        <h1 id="resource-title" class="mt-4 text-3xl font-semibold tracking-tight text-base-content sm:text-4xl">{resource.name}</h1>
        <p class="mt-4 text-base leading-7 text-base-content/60">{resource.description}</p>
      </section>

      <div class="stats stats-vertical mt-8 w-full border-y border-base-300 sm:stats-horizontal" aria-label="Resource metadata">
        <div class="stat px-0 py-4 sm:pr-6">
          <div class="stat-title text-xs">Resource ID</div>
          <div class="stat-value mt-1 break-all font-mono text-xs">{resourceId(resource)}</div>
        </div>
        <div class="stat border-base-300 px-0 py-4 sm:border-l sm:px-6">
          <div class="stat-title text-xs">Latest version</div>
          <div class="stat-value mt-1 text-sm">v{resource.latestVersion}</div>
        </div>
        <div class="stat border-base-300 px-0 py-4 sm:border-l sm:pl-6">
          <div class="stat-title text-xs">Owner</div>
          <div class="stat-value mt-1 text-sm">{resource.owner}</div>
        </div>
      </div>

      {resource.reviewStatus === 'unreviewed' && (
        <div class="alert alert-warning mt-6 max-w-3xl items-start text-sm leading-6" role="status">
          <i class="ph ph-warning text-xl" aria-hidden="true"></i>
          <div>
          This resource is unreviewed. You can stage it, but inspect its contents before applying
          it to a project.
          </div>
        </div>
      )}

      <section
        class="mt-14 w-full border-t border-base-300 pt-8"
        aria-labelledby="install-title"
        data-resource-install
        data-api-url={apiUrl}
        data-resource-id={resourceId(resource)}
        data-resource-type={resource.type}
        data-resource-components={JSON.stringify(componentResources)}
      >
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Install</p>
        <h2 id="install-title" class="mt-2 text-xl font-semibold tracking-tight text-base-content">Use this resource locally</h2>
        {resource.type === 'templates' && (
          <div class="alert alert-info mt-5 items-start text-sm leading-6" role="status">
            <i class="ph ph-package text-xl" aria-hidden="true"></i>
            <div>
            This template stages its component resources as one pack. Review the complete file
            change before applying it.
            </div>
          </div>
        )}
        <div class="card mt-6 border border-base-300 bg-base-100">
          <div class="card-body p-5">
          <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_12rem]">
            <fieldset class="fieldset">
              <legend class="fieldset-legend">Harnesses</legend>
              <div class="grid gap-3 sm:grid-cols-3">
                <label class="label cursor-pointer justify-start gap-2"><input class="checkbox checkbox-primary" type="checkbox" value="claude-code" data-install-harness checked />
                  Claude Code
                </label>
                <label class="label cursor-pointer justify-start gap-2"><input class="checkbox checkbox-primary" type="checkbox" value="opencode" data-install-harness />
                  OpenCode
                </label>
                <label class="label cursor-pointer justify-start gap-2"><input class="checkbox checkbox-primary" type="checkbox" value="codex" data-install-harness />
                  Codex
                </label>
              </div>
            </fieldset>
            <label class="fieldset" for="install-scope">
              <span class="fieldset-legend">Scope</span>
              <select class="select select-bordered w-full" id="install-scope" data-install-scope>
                <option value="project">This project</option>
                <option value="global">All projects</option>
              </select>
            </label>
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            <button class="btn btn-primary" type="button" data-install-action>Review install</button>
            <button class="btn btn-outline hidden" type="button" data-update-action hidden>
              Review update
            </button>
            <button class="btn btn-outline hidden" type="button" data-uninstall-action hidden>
              Review uninstall
            </button>
            <button class="btn btn-warning btn-outline hidden" type="button" data-force-action hidden>
              Continue with force
            </button>
          </div>
          <p class="mt-4 text-sm text-base-content/60" data-install-status role="status">
            Checking local installations…
          </p>
          </div>
        </div>
        <div class="card mt-5 hidden border border-base-300 bg-base-100" data-detail-plan hidden>
          <div class="card-body p-5">
          <div class="flex flex-wrap items-start justify-between gap-4 border-b border-base-300 pb-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Change plan</p>
              <h3 class="mt-2 text-lg font-semibold tracking-tight text-base-content">Review before applying</h3>
            </div>
            <button class="btn btn-ghost btn-sm" type="button" data-detail-plan-close>Close</button>
          </div>
          <div class="stats stats-vertical mt-4 w-full border-y border-base-300 sm:stats-horizontal">
            <div class="stat px-0 py-3 sm:pr-4"><div class="stat-value text-xl" data-detail-count="added">0</div><div class="stat-title text-xs">Added</div></div>
            <div class="stat border-base-300 px-0 py-3 sm:border-l sm:px-4"><div class="stat-value text-xl" data-detail-count="modified">0</div><div class="stat-title text-xs">Modified</div></div>
            <div class="stat border-base-300 px-0 py-3 sm:border-l sm:pl-4"><div class="stat-value text-xl" data-detail-count="removed">0</div><div class="stat-title text-xs">Removed</div></div>
          </div>
          <div class="mt-4 space-y-4" data-detail-plan-lists>
            <section class="hidden" data-detail-section="added"><h4 class="text-sm font-semibold text-base-content">Added files</h4><ul class="mt-2 space-y-2" data-detail-list="added"></ul></section>
            <section class="hidden" data-detail-section="modified"><h4 class="text-sm font-semibold text-base-content">Modified files</h4><ul class="mt-2 space-y-2" data-detail-list="modified"></ul></section>
            <section class="hidden" data-detail-section="removed"><h4 class="text-sm font-semibold text-base-content">Removed files</h4><ul class="mt-2 space-y-2" data-detail-list="removed"></ul></section>
            <p class="hidden rounded-box border border-base-300 bg-base-200 p-3 text-sm text-base-content/60" data-detail-empty>No file changes are needed.</p>
          </div>
          <div class="alert alert-warning mt-4 hidden items-start text-sm" data-detail-conflicts role="alert"></div>
          <div class="alert alert-warning mt-4 hidden items-start text-sm" data-detail-warnings></div>
          <label class="label mt-4 hidden items-start gap-3 rounded-box border border-base-300 p-4" data-detail-force-label>
            <input class="checkbox checkbox-warning mt-0.5" type="checkbox" data-detail-force-input />
            <span><strong class="font-semibold">Allow overwrite or removal of locally changed files</strong><span class="mt-1 block text-xs text-base-content/60">Use this only after checking the affected files.</span></span>
          </label>
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm text-base-content/60" data-detail-plan-status role="status"></p>
            <button class="btn btn-primary" type="button" data-detail-apply disabled>Apply changes</button>
          </div>
          </div>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <div class="mockup-code rounded-box p-4 text-xs before:hidden">
            <label class="block font-semibold text-base-content/70" for="project-command">Project scope</label>
            <code class="mt-2 block break-all font-mono leading-5" id="project-command">{installBase} --scope project</code>
          </div>
          <div class="mockup-code rounded-box p-4 text-xs before:hidden">
            <label class="block font-semibold text-base-content/70" for="global-command">Global scope</label>
            <code class="mt-2 block break-all font-mono leading-5" id="global-command">{installBase} --scope global</code>
          </div>
        </div>
      </section>

      <section class="mt-14 w-full border-t border-base-300 pt-8" aria-labelledby="files-title">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Source</p>
        <h2 id="files-title" class="mt-2 text-xl font-semibold tracking-tight text-base-content">Files in v{version?.version ?? resource.latestVersion}</h2>
        {fileError ? (
          <div class="alert alert-error mt-5 items-start text-sm" role="alert">
            <i class="ph ph-warning-circle text-xl" aria-hidden="true"></i>
            <div>
              <strong class="font-semibold">Resource files are not available in this checkout.</strong>
              <p class="mt-2">{fileError}</p>
            </div>
          </div>
        ) : version ? (
          <div class="card mt-5 divide-y divide-base-300 overflow-hidden border border-base-300 bg-base-100">
            {version.files.map((file, index) => (
              <details class="group" open={index === 0}>
                <summary class="cursor-pointer list-none px-4 py-3 text-sm font-medium text-base-content marker:hidden group-open:text-primary">{file.path}</summary>
                <pre class="mockup-code overflow-x-auto border-t border-base-300 bg-base-200 p-4 text-xs leading-6 before:hidden"><code>{file.content}</code></pre>
              </details>
            ))}
          </div>
        ) : (
          <div class="card mt-5 border border-base-300 bg-base-100">
            <div class="card-body p-6">
              <strong class="font-semibold text-base-content">No files found.</strong>
              <p class="mt-2 text-sm text-base-content/60">The registry index points to a package with no readable files.</p>
            </div>
          </div>
        )}
      </section>
    </main>

    <footer class="footer mx-auto w-full max-w-6xl border-t border-base-300 px-5 py-6 text-xs text-base-content/60 sm:px-8">
      <p>Backed by the production branch of the resources repository.</p>
      <a class="link link-hover font-medium" href="/">Return to catalog</a>
    </footer>

    <script>
      type Installation = {
        resource: string;
        version: string;
        harness: string;
        scope: string;
      };
      type Action = 'install' | 'update' | 'uninstall';
      type DetailChange = {
        path: string;
        action: 'added' | 'modified' | 'removed';
        resource: string;
        harness: string;
        scope: string;
        before?: string;
        after?: string;
      };
      type DetailPlan = { changes: DetailChange[]; conflicts: string[]; warnings: string[] };

      const panel = document.querySelector<HTMLElement>('[data-resource-install]');
      const apiBase = panel?.dataset.apiUrl ?? 'http://127.0.0.1:4317';
      const resourceKey = panel?.dataset.resourceId ?? '';
      let componentKeys: string[] = [];
      try {
        const parsed = JSON.parse(panel?.dataset.resourceComponents ?? '[]');
        if (Array.isArray(parsed)) {
          componentKeys = parsed.filter((item): item is string => typeof item === 'string');
        }
      } catch {
        componentKeys = [];
      }
      const trackedResources = componentKeys.length > 0 ? componentKeys : [resourceKey];
      const harnesses = Array.from(
        document.querySelectorAll<HTMLInputElement>('[data-install-harness]'),
      );
      const scope = document.querySelector<HTMLSelectElement>('[data-install-scope]');
      const install = document.querySelector<HTMLButtonElement>('[data-install-action]');
      const update = document.querySelector<HTMLButtonElement>('[data-update-action]');
      const uninstall = document.querySelector<HTMLButtonElement>('[data-uninstall-action]');
      const force = document.querySelector<HTMLButtonElement>('[data-force-action]');
      const status = document.querySelector<HTMLElement>('[data-install-status]');
      const detailPlan = document.querySelector<HTMLElement>('[data-detail-plan]');
      const detailPlanClose = document.querySelector<HTMLButtonElement>('[data-detail-plan-close]');
      const detailApply = document.querySelector<HTMLButtonElement>('[data-detail-apply]');
      const detailForceLabel = document.querySelector<HTMLElement>('[data-detail-force-label]');
      const detailForceInput = document.querySelector<HTMLInputElement>('[data-detail-force-input]');
      const detailPlanStatus = document.querySelector<HTMLElement>('[data-detail-plan-status]');
      let currentRecords: Installation[] = [];
      let currentOperations: Array<{ resource: string; harnesses: string[]; scope: string; action: 'install' | 'uninstall' }> = [];
      let currentPlan: DetailPlan | null = null;

      function setHidden(element: HTMLElement | null, hidden: boolean) {
        if (!element) return;
        element.hidden = hidden;
        element.classList.toggle('hidden', hidden);
      }

      function selectedHarnesses(): string[] {
        return harnesses.filter((input) => input.checked).map((input) => input.value);
      }

      function showStatus(message: string, isError = false) {
        if (!status) return;
        status.textContent = message;
        status.dataset.error = isError ? 'true' : 'false';
      }

      function hasCompleteInstallation(records: Installation[], harness: string): boolean {
        return trackedResources.every((resource) =>
          records.some((record) => record.resource === resource && record.harness === harness),
        );
      }

      function render(records: Installation[]) {
        currentRecords = records;
        const selected = selectedHarnesses();
        const installed = selected.filter((harness) => hasCompleteInstallation(records, harness));
        const missing = selected.filter((harness) => !hasCompleteInstallation(records, harness));
        setHidden(install, selected.length === 0 || missing.length === 0);
        setHidden(update, selected.length === 0 || installed.length === 0);
        setHidden(uninstall, selected.length === 0 || installed.length === 0);
        setHidden(force, true);

        if (selected.length === 0) {
          showStatus('Select at least one harness.');
          return;
        }

        const installedText = installed.length > 0
          ? `Installed for ${installed.join(', ')}`
          : 'Not installed';
        const missingText = missing.length > 0 ? `Not fully installed for ${missing.join(', ')}` : '';
        showStatus([installedText, missingText].filter(Boolean).join('. ') + '.');
      }

      function targetHarnesses(action: Action): string[] {
        const selected = selectedHarnesses();

        if (action === 'install') {
          return selected.filter((harness) => !hasCompleteInstallation(currentRecords, harness));
        }

        return selected.filter((harness) => hasCompleteInstallation(currentRecords, harness));
      }

      async function request(path: string, init?: RequestInit) {
        const response = await fetch(`${apiBase}${path}`, init);
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error ?? 'The local API request failed.');
        return result;
      }

      async function loadInstallation(): Promise<Installation[]> {
        if (selectedHarnesses().length === 0) {
          render([]);
          return [];
        }

        try {
          const result = await request(
            `/api/installed?scope=${encodeURIComponent(scope?.value ?? 'project')}`,
          );
          const selected = selectedHarnesses();
          const records = Array.isArray(result.installations)
            ? result.installations.filter(
                (item: Installation) =>
                  trackedResources.includes(item.resource) &&
                  selected.includes(item.harness) &&
                  item.scope === scope?.value,
              )
            : [];
          render(records);
          return records;
        } catch (error) {
          showStatus(error instanceof Error ? error.message : 'Could not reach the local API.', true);
          return [];
        }
      }

      function setBusy(busy: boolean) {
        for (const button of [install, update, uninstall, force]) {
          if (button) button.disabled = busy;
        }
        for (const harness of harnesses) harness.disabled = busy;
        if (scope) scope.disabled = busy;
      }

      function appendDetailChange(list: HTMLElement, change: DetailChange) {
        const item = document.createElement('li');
        item.className = 'card border border-base-300 bg-base-200';
        const header = document.createElement('div');
        header.className = 'flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between';
        const path = document.createElement('span');
        path.className = 'break-all font-mono text-xs font-semibold text-base-content';
        path.textContent = change.path;
        const meta = document.createElement('span');
        meta.className = 'text-xs text-base-content/60';
        meta.textContent = `${change.harness} · ${change.scope}`;
        header.append(path, meta);
        const body = document.createElement('div');
        body.className = 'card-body gap-3 p-3';
        body.append(header);
        const content = change.after ?? change.before;
        if (content) {
          const details = document.createElement('details');
          details.className = 'mt-3 border-t border-base-300 pt-3';
          const summary = document.createElement('summary');
          summary.className = 'cursor-pointer text-xs font-semibold text-primary';
          summary.textContent = change.action === 'modified' ? 'View file change' : 'View file content';
          const pre = document.createElement('pre');
          pre.className = 'mockup-code mt-3 max-h-64 overflow-auto rounded-box p-3 text-xs leading-5 before:hidden';
          pre.textContent = change.action === 'modified'
            ? `Before:\n${change.before ?? '(file did not exist)'}\n\nAfter:\n${change.after ?? '(file will be removed)'}`
            : content;
          details.append(summary, pre);
          body.append(details);
        }
        item.append(body);
        list.append(item);
      }

      function renderDetailPlan(plan: DetailPlan) {
        currentPlan = plan;
        setHidden(detailPlan, false);
        for (const action of ['added', 'modified', 'removed'] as const) {
          const changes = plan.changes.filter((change) => change.action === action);
          const total = document.querySelector<HTMLElement>(`[data-detail-count="${action}"]`);
          const section = document.querySelector<HTMLElement>(`[data-detail-section="${action}"]`);
          const list = document.querySelector<HTMLElement>(`[data-detail-list="${action}"]`);
          if (total) total.textContent = String(changes.length);
          setHidden(section, changes.length === 0);
          list?.replaceChildren();
          if (list) for (const change of changes) appendDetailChange(list, change);
        }
        setHidden(document.querySelector<HTMLElement>('[data-detail-empty]'), plan.changes.length !== 0);
        const conflicts = document.querySelector<HTMLElement>('[data-detail-conflicts]');
        if (conflicts) {
          conflicts.textContent = plan.conflicts.length > 0
            ? `Review required: ${plan.conflicts.join(' ')}`
            : '';
          setHidden(conflicts, plan.conflicts.length === 0);
        }
        const warnings = document.querySelector<HTMLElement>('[data-detail-warnings]');
        if (warnings) {
          warnings.textContent = plan.warnings.length > 0
            ? `Unreviewed resources: ${plan.warnings.join(', ')}`
            : '';
          setHidden(warnings, plan.warnings.length === 0);
        }
        setHidden(detailForceLabel, plan.conflicts.length === 0);
        if (detailForceInput) detailForceInput.checked = false;
        if (detailApply) detailApply.disabled = plan.changes.length === 0 || plan.conflicts.length > 0;
        if (detailPlanStatus) detailPlanStatus.textContent = plan.changes.length === 0
          ? 'No changes are needed.'
          : `${plan.changes.length} file${plan.changes.length === 1 ? '' : 's'} ready to apply.`;
      }

      async function run(action: Action) {
        setBusy(true);
        showStatus('Preparing change plan…');

        try {
          const targets = targetHarnesses(action);

          if (targets.length === 0) {
            showStatus(action === 'install' ? 'All selected harnesses are installed.' : 'No selected harness is installed.');
            return;
          }

          currentOperations = [{
            resource: resourceKey,
            harnesses: targets,
            scope: scope?.value ?? 'project',
            action: action === 'uninstall' ? 'uninstall' : 'install',
          }];
          const result = await request('/api/plan', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ operations: currentOperations }),
          });
          renderDetailPlan(result as DetailPlan);
          showStatus('Review the file changes, then apply them together.');
          detailPlan?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (error) {
          const message = error instanceof Error ? error.message : 'The operation failed.';
          showStatus(message, true);
        } finally {
          setBusy(false);
        }
      }

      install?.addEventListener('click', () => run('install'));
      update?.addEventListener('click', () => run('update'));
      uninstall?.addEventListener('click', () => run('uninstall'));
      detailPlanClose?.addEventListener('click', () => setHidden(detailPlan, true));
      detailForceInput?.addEventListener('change', () => {
        if (detailApply && currentPlan) detailApply.disabled = currentPlan.changes.length === 0 || (currentPlan.conflicts.length > 0 && !detailForceInput.checked);
      });
      detailApply?.addEventListener('click', async () => {
        if (currentOperations.length === 0 || !currentPlan) return;
        const forceChanges = detailForceInput?.checked === true;
        if (currentPlan.conflicts.length > 0 && !forceChanges) return;
        detailApply.disabled = true;
        if (detailPlanStatus) detailPlanStatus.textContent = 'Applying all changes…';
        try {
          const result = await request('/api/apply', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ operations: currentOperations, force: forceChanges }),
          });
          await loadInstallation();
          currentOperations = [];
          if (detailPlanStatus) detailPlanStatus.textContent = `Applied ${result.plan.changes.length} file change${result.plan.changes.length === 1 ? '' : 's'}.`;
        } catch (error) {
          if (detailPlanStatus) detailPlanStatus.textContent = error instanceof Error ? error.message : 'Could not apply the change plan.';
          detailApply.disabled = false;
        }
      });
      for (const harness of harnesses) {
        harness.addEventListener('change', () => void loadInstallation());
      }
      scope?.addEventListener('change', () => void loadInstallation());
      if (panel?.dataset.resourceType !== 'templates') void loadInstallation();
    </script>
  </body>
</html>
