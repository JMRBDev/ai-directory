---
import { homedir } from 'node:os';
import { resourceKey, type ResourceType } from '@ai-directory/contracts';
import { resolveApiUrl } from '../../../../lib/api';
import { loadRegistry, loadResource } from '../../../../lib/registry';
import ThemeInit from '../../../../components/ThemeInit.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import ChangeDeckProvider from '../../../../components/preact/ChangeDeck';
import InstallResource from '../../../../components/preact/InstallResource';
import PublishForm from '../../../../components/preact/PublishForm';
import SettingsDrawer from '../../../../components/preact/SettingsDrawer';
import { RESOURCE_TYPE_LABELS } from '../../../../components/preact/lib';
import '../../../../styles/global.css';

// SAFETY: TYPE_ICONS covers every ResourceType.
const TYPE_ICONS = {
  skills: 'ph-lightning',
  agents: 'ph-user-circle-gear',
  rules: 'ph-scroll',
  'mcp-servers': 'ph-plugs-connected',
  templates: 'ph-layout',
  plugins: 'ph-puzzle-piece',
} satisfies Record<ResourceType, string>;

const requestedResourceId = [Astro.params.owner, Astro.params.type, Astro.params.name].join('/');
const registry = await loadRegistry();
const resource = registry.index?.resources.find(
  (candidate) =>
    candidate.lifecycleStatus === 'active' && resourceKey(candidate) === requestedResourceId,
);

if (!resource) return Astro.redirect('/');

const result = await loadResource(registry.indexPath, resource, registry.repository);
const { version, componentResources } = {
  version: result.version,
  componentResources: result.resources.map((item) => resourceKey(item.resource)),
};
const fileError = result.error;
const activeResources = (registry.index?.resources ?? []).filter(
  (candidate) => candidate.lifecycleStatus === 'active',
);
const title = `${resource.name} | AI Directory`;
const installBase = `aid install ${resourceKey(resource)} --harness claude-code${resource.type === 'mcp-servers' ? ' --scope user' : ''}`;
const apiUrl = import.meta.env.PUBLIC_AI_DIRECTORY_API_URL ?? resolveApiUrl(Astro.url.hostname);
const homeDir = homedir();

const updatedLabel = (() => {
  const date = new Date(resource.updatedAt);
  return Number.isNaN(date.getTime())
    ? resource.updatedAt
    : new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(date);
})();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={resource.description} />
    <ThemeInit />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased flex flex-col gap-2">
    <SiteHeader showChanges showInstalled showPublish showRefresh showSettings />

    <main class="mx-auto w-full max-w-6xl px-5 sm:px-8 flex-1">
      <ChangeDeckProvider
        client:load
        apiUrl={apiUrl}
        homeDir={homeDir}
        resources={activeResources}
        registryError={registry.error}
        hideCatalog
      >
        <section class="mt-8 max-w-3xl" aria-labelledby="resource-title">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge badge-primary badge-soft gap-1.5">
              <i class={'ph ' + TYPE_ICONS[resource.type]} aria-hidden="true"></i>
              {RESOURCE_TYPE_LABELS[resource.type]}
            </span>
            <span
              class:list={[
                'badge badge-soft gap-1',
                resource.reviewStatus === 'reviewed' ? 'badge-success' : 'badge-warning',
              ]}
            >
              <i
                class={'ph ' + (resource.reviewStatus === 'reviewed' ? 'ph-check' : 'ph-warning')}
                aria-hidden="true"
              ></i>
              {resource.reviewStatus === 'reviewed' ? 'Reviewed' : 'Unreviewed'}
            </span>
            <span class="badge badge-ghost gap-1">
              <i class="ph ph-tag" aria-hidden="true"></i>
              v{version?.version ?? resource.latestVersion}
            </span>
          </div>
          <h1 id="resource-title" class="mt-4 text-3xl font-semibold tracking-tight text-base-content sm:text-4xl">{resource.name}</h1>
          <p class="mt-3 text-base leading-7 text-base-content/60">{resource.description}</p>
<div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-base-content/60">
            <span class="inline-flex items-center gap-1.5">
              <i class="ph ph-user" aria-hidden="true"></i>
              {resource.owner}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <i class="ph ph-clock" aria-hidden="true"></i>
              Updated {updatedLabel}
            </span>
          </div>
        </section>

        <InstallResource
          client:load
          apiUrl={apiUrl}
          homeDir={homeDir}
          resourceKey={resourceKey(resource)}
          resourceType={resource.type}
          componentResources={componentResources}
          installBase={installBase}
        />

        <section class="mt-14" aria-labelledby="files-title">
          <h2 id="files-title" class="text-xl font-semibold tracking-tight text-base-content">Source files</h2>
          {fileError ? (
            <div class="alert alert-error mt-5 items-start text-sm" role="alert">
              <i class="ph ph-warning-circle text-xl" aria-hidden="true"></i>
              <div>
                <strong class="font-semibold">Resource files are not available in this checkout.</strong>
                <p class="mt-2">{fileError}</p>
              </div>
            </div>
          ) : version ? (
            <div class="card card-border mt-5 overflow-hidden bg-base-100">
              {version.files.map((file, index) => (
                <details class="collapse collapse-arrow rounded-none border-b border-base-300 last:border-b-0" open={index === 0}>
                  <summary class="collapse-title min-h-0 px-4 py-3 text-sm font-medium text-base-content">{file.path}</summary>
                  <div class="collapse-content p-0">
                    <div class="mockup-code overflow-x-auto rounded-none border-t border-base-300 bg-base-200 p-4 text-xs leading-6 before:hidden">
                      <pre><code>{file.content}</code></pre>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          ) : (
            <div class="card mt-5 border border-base-300 bg-base-100">
              <div class="card-body p-6">
                <strong class="font-semibold text-base-content">No files found.</strong>
                <p class="mt-2 text-sm text-base-content/60">The registry index points to a package with no readable files.</p>
              </div>
            </div>
          )}
        </section>
      </ChangeDeckProvider>
    </main>

    <SettingsDrawer client:load apiUrl={apiUrl} />
    <PublishForm client:load apiUrl={apiUrl} />

    <footer class="flex justify-between items-center gap-3 footer mx-auto w-full max-w-6xl border-t border-base-300 px-5 py-6 text-xs text-base-content/60 sm:px-8">
      <p>Backed by the production branch of the resources repository.</p>
      <a class="link link-hover font-medium" href="/">Return to catalog</a>
    </footer>
  </body>
</html>