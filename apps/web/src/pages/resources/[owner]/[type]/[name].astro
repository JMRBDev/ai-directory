---
import type { ResourceSummary } from '@ai-directory/contracts';
import {
  loadRegistry,
  loadResource,
  resourceId,
  type RegistryView,
} from '../../../../lib/registry';
import '../../../../styles/catalog.css';

type Props = {
  resource: ResourceSummary;
  version: Awaited<ReturnType<typeof loadResource>>['version'];
  componentResources: string[];
  source: RegistryView['source'];
  fileError?: string;
};

const requestedResourceId = [Astro.params.owner, Astro.params.type, Astro.params.name].join('/');
const registry = await loadRegistry();
const resource = registry.index?.resources.find(
  (candidate) =>
    candidate.lifecycleStatus === 'active' && resourceId(candidate) === requestedResourceId,
);

if (!resource) return Astro.redirect('/');

const result = await loadResource(registry.indexPath, resource, registry.repository);
const { version, componentResources, source, fileError } = {
  resource,
  version: result.version,
  componentResources: result.resources.map((item) => resourceId(item.resource)),
  source: registry.source,
  ...(result.error ? { fileError: result.error } : {}),
} satisfies Props;
const title = `${resource.name} | AI Directory`;
const installBase = `aid install ${resourceId(resource)} --harness claude-code`;
const apiUrl = import.meta.env.PUBLIC_AI_DIRECTORY_API_URL ?? 'http://127.0.0.1:4317';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={resource.description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/">AI DIRECTORY <span>RESOURCE REGISTRY</span></a>
        <span class="header-state">
          {source === 'remote' ? 'Configured Git registry' : 'Explicit local index'}
        </span>
      </div>
    </header>

    <main class="page-shell detail-shell">
      <a class="back-link" href="/">Back to catalog</a>

      <section class="detail-heading" aria-labelledby="resource-title">
        <div class="resource-card-top">
          <span class="resource-type">{resource.type}</span>
          <span
            class:list={[
              'resource-status',
              resource.reviewStatus === 'unreviewed' && 'unreviewed',
            ]}
          >
            {resource.reviewStatus === 'reviewed' ? 'Reviewed' : 'Unreviewed'}
          </span>
        </div>
        <h1 id="resource-title">{resource.name}</h1>
        <p>{resource.description}</p>
      </section>

      <div class="detail-meta" aria-label="Resource metadata">
        <div class="detail-meta-item">
          <span class="meta-label">Resource ID</span>
          <span class="meta-value">{resourceId(resource)}</span>
        </div>
        <div class="detail-meta-item">
          <span class="meta-label">Latest version</span>
          <span class="meta-value">v{resource.latestVersion}</span>
        </div>
        <div class="detail-meta-item">
          <span class="meta-label">Owner</span>
          <span class="meta-value">{resource.owner}</span>
        </div>
      </div>

      {resource.reviewStatus === 'unreviewed' && (
        <div class="warning" role="status">
          This resource is unreviewed. You can install it, but inspect its contents before using
          it in a project.
        </div>
      )}

      <section
        class="detail-section"
        aria-labelledby="install-title"
        data-resource-install
        data-api-url={apiUrl}
        data-resource-id={resourceId(resource)}
        data-resource-type={resource.type}
        data-resource-components={JSON.stringify(componentResources)}
      >
        <p class="section-kicker">Install</p>
        <h2 id="install-title">Use this resource locally</h2>
        {resource.type === 'templates' && (
          <div class="warning" role="status">
            This template installs its component resources as one pack. You can update or uninstall
            the pack from here later.
          </div>
        )}
        <div class="install-form">
          <div class="install-controls">
            <fieldset class="harness-options">
              <legend class="filter-label">Harnesses</legend>
              <label>
                <input type="checkbox" value="claude-code" data-install-harness checked />
                Claude Code
              </label>
              <label>
                <input type="checkbox" value="opencode" data-install-harness />
                OpenCode
              </label>
              <label>
                <input type="checkbox" value="codex" data-install-harness />
                Codex
              </label>
            </fieldset>
            <label class="filter-field" for="install-scope">
              <span class="filter-label">Scope</span>
              <select id="install-scope" data-install-scope>
                <option value="project">This project</option>
                <option value="global">All projects</option>
              </select>
            </label>
          </div>
          <div class="detail-actions">
            <button type="button" data-install-action>Install resource</button>
            <button class="secondary-button" type="button" data-update-action hidden>
              Update resource
            </button>
            <button class="secondary-button" type="button" data-uninstall-action hidden>
              Uninstall
            </button>
            <button class="secondary-button" type="button" data-force-action hidden>
              Continue with force
            </button>
          </div>
          <p class="form-status" data-install-status role="status">
            Checking local installations…
          </p>
        </div>
        <div class="commands">
          <div class="command">
            <label for="project-command">Project scope</label>
            <code id="project-command">{installBase} --scope project</code>
          </div>
          <div class="command">
            <label for="global-command">Global scope</label>
            <code id="global-command">{installBase} --scope global</code>
          </div>
        </div>
      </section>

      <section class="detail-section" aria-labelledby="files-title">
        <p class="section-kicker">Source</p>
        <h2 id="files-title">Files in v{version?.version ?? resource.latestVersion}</h2>
        {fileError ? (
          <div class="error-state" role="alert">
            <strong>Resource files are not available in this checkout.</strong>
            <p>{fileError}</p>
          </div>
        ) : version ? (
          <div class="file-list">
            {version.files.map((file, index) => (
              <details open={index === 0}>
                <summary>{file.path}</summary>
                <pre><code>{file.content}</code></pre>
              </details>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <strong>No files found.</strong>
            <p>The registry index points to a package with no readable files.</p>
          </div>
        )}
      </section>
    </main>

    <footer class="site-footer">
      <p>AI Directory is backed by the production branch of the resources repository.</p>
      <a class="back-link" href="/">Return to catalog</a>
    </footer>

    <script>
      type Installation = {
        resource: string;
        version: string;
        harness: string;
        scope: string;
      };
      type Action = 'install' | 'update' | 'uninstall';

      const panel = document.querySelector<HTMLElement>('[data-resource-install]');
      const apiBase = panel?.dataset.apiUrl ?? 'http://127.0.0.1:4317';
      const resourceKey = panel?.dataset.resourceId ?? '';
      let componentKeys: string[] = [];
      try {
        const parsed = JSON.parse(panel?.dataset.resourceComponents ?? '[]');
        if (Array.isArray(parsed)) {
          componentKeys = parsed.filter((item): item is string => typeof item === 'string');
        }
      } catch {
        componentKeys = [];
      }
      const trackedResources = componentKeys.length > 0 ? componentKeys : [resourceKey];
      const harnesses = Array.from(
        document.querySelectorAll<HTMLInputElement>('[data-install-harness]'),
      );
      const scope = document.querySelector<HTMLSelectElement>('[data-install-scope]');
      const install = document.querySelector<HTMLButtonElement>('[data-install-action]');
      const update = document.querySelector<HTMLButtonElement>('[data-update-action]');
      const uninstall = document.querySelector<HTMLButtonElement>('[data-uninstall-action]');
      const force = document.querySelector<HTMLButtonElement>('[data-force-action]');
      const status = document.querySelector<HTMLElement>('[data-install-status]');
      let forceAction: Action | null = null;
      let currentRecords: Installation[] = [];

      function selectedHarnesses(): string[] {
        return harnesses.filter((input) => input.checked).map((input) => input.value);
      }

      function showStatus(message: string, isError = false) {
        if (!status) return;
        status.textContent = message;
        status.dataset.error = isError ? 'true' : 'false';
      }

      function hasCompleteInstallation(records: Installation[], harness: string): boolean {
        return trackedResources.every((resource) =>
          records.some((record) => record.resource === resource && record.harness === harness),
        );
      }

      function render(records: Installation[]) {
        currentRecords = records;
        const selected = selectedHarnesses();
        const installed = selected.filter((harness) => hasCompleteInstallation(records, harness));
        const missing = selected.filter((harness) => !hasCompleteInstallation(records, harness));
        if (install) install.hidden = selected.length === 0 || missing.length === 0;
        if (update) update.hidden = selected.length === 0 || installed.length === 0;
        if (uninstall) uninstall.hidden = selected.length === 0 || installed.length === 0;
        if (force) force.hidden = true;
        forceAction = null;

        if (selected.length === 0) {
          showStatus('Select at least one harness.');
          return;
        }

        const installedText = installed.length > 0
          ? `Installed for ${installed.join(', ')}`
          : 'Not installed';
        const missingText = missing.length > 0 ? `Not fully installed for ${missing.join(', ')}` : '';
        showStatus([installedText, missingText].filter(Boolean).join('. ') + '.');
      }

      function targetHarnesses(action: Action): string[] {
        const selected = selectedHarnesses();

        if (action === 'install') {
          return selected.filter((harness) => !hasCompleteInstallation(currentRecords, harness));
        }

        return selected.filter((harness) => hasCompleteInstallation(currentRecords, harness));
      }

      async function request(path: string, init?: RequestInit) {
        const response = await fetch(`${apiBase}${path}`, init);
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error ?? 'The local API request failed.');
        return result;
      }

      async function loadInstallation(): Promise<Installation[]> {
        if (selectedHarnesses().length === 0) {
          render([]);
          return [];
        }

        try {
          const result = await request(
            `/api/installed?scope=${encodeURIComponent(scope?.value ?? 'project')}`,
          );
          const selected = selectedHarnesses();
          const records = Array.isArray(result.installations)
            ? result.installations.filter(
                (item: Installation) =>
                  trackedResources.includes(item.resource) &&
                  selected.includes(item.harness) &&
                  item.scope === scope?.value,
              )
            : [];
          render(records);
          return records;
        } catch (error) {
          showStatus(error instanceof Error ? error.message : 'Could not reach the local API.', true);
          return [];
        }
      }

      function setBusy(busy: boolean) {
        for (const button of [install, update, uninstall, force]) {
          if (button) button.disabled = busy;
        }
        for (const harness of harnesses) harness.disabled = busy;
        if (scope) scope.disabled = busy;
      }

      async function run(action: Action, useForce = false) {
        if (useForce && !window.confirm('This may overwrite or remove local changes. Continue?')) {
          return;
        }

        setBusy(true);
        showStatus('Working…');

        try {
          const targets = targetHarnesses(action);

          if (targets.length === 0) {
            showStatus(action === 'install' ? 'All selected harnesses are installed.' : 'No selected harness is installed.');
            return;
          }

          const body = {
            resource: resourceKey,
            harnesses: targets,
            scope: scope?.value,
            ...(useForce ? { force: true } : {}),
          };
          const result = action === 'uninstall'
            ? await request(
                `/api/installed?resource=${encodeURIComponent(resourceKey)}&harnesses=${encodeURIComponent(targets.join(','))}&scope=${encodeURIComponent(scope?.value ?? '')}${useForce ? '&force=true' : ''}`,
                { method: 'DELETE' },
              )
            : await request(`/api/${action}`, {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(body),
              });
          const warnings = Array.isArray(result.warnings) ? result.warnings : [];
          await loadInstallation();
          if (warnings.length > 0) {
            showStatus(`Completed with warning. Unreviewed: ${warnings.join(', ')}`);
          }
        } catch (error) {
          const message = error instanceof Error ? error.message : 'The operation failed.';
          showStatus(message, true);

          if (action !== 'install' && /modified|ownership hashes/u.test(message)) {
            forceAction = action;
            if (force) {
              force.hidden = false;
              force.textContent = action === 'update' ? 'Force update' : 'Force uninstall';
            }
          }
        } finally {
          setBusy(false);
        }
      }

      install?.addEventListener('click', () => run('install'));
      update?.addEventListener('click', () => run('update'));
      uninstall?.addEventListener('click', () => run('uninstall'));
      force?.addEventListener('click', () => {
        if (forceAction) void run(forceAction, true);
      });
      for (const harness of harnesses) {
        harness.addEventListener('change', () => void loadInstallation());
      }
      scope?.addEventListener('change', () => void loadInstallation());
      if (panel?.dataset.resourceType !== 'templates') void loadInstallation();
    </script>
  </body>
</html>
