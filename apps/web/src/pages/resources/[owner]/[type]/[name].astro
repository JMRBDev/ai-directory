---
import { homedir } from 'node:os';
import type { ResourceSummary } from '@ai-directory/contracts';
import { resourceKey } from '@ai-directory/contracts';
import { resolveApiUrl } from '../../../../lib/api';
import {
  loadRegistry,
  loadResource,
  type RegistryView,
} from '../../../../lib/registry';
import ThemeInit from '../../../../components/ThemeInit.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import InstallResource from '../../../../components/preact/InstallResource';
import SettingsDrawer from '../../../../components/preact/SettingsDrawer';
import '../../../../styles/global.css';

interface Props {
  resource: ResourceSummary;
  version: Awaited<ReturnType<typeof loadResource>>['version'];
  componentResources: string[];
  source: RegistryView['source'];
  fileError?: string;
}

const requestedResourceId = [Astro.params.owner, Astro.params.type, Astro.params.name].join('/');
const registry = await loadRegistry();
const resource = registry.index?.resources.find(
  (candidate) =>
    candidate.lifecycleStatus === 'active' && resourceKey(candidate) === requestedResourceId,
);

if (!resource) return Astro.redirect('/');

const result = await loadResource(registry.indexPath, resource, registry.repository);
const props: Props = {
  resource,
  version: result.version,
  componentResources: result.resources.map((item) => resourceKey(item.resource)),
  source: registry.source,
};
if (result.error) props.fileError = result.error;
const { version, componentResources, source, fileError } = props;
const title = `${resource.name} | AI Directory`;
const installBase = `aid install ${resourceKey(resource)} --harness claude-code${resource.type === 'mcp-servers' ? ' --scope user' : ''}`;
const apiUrl = import.meta.env.PUBLIC_AI_DIRECTORY_API_URL ?? resolveApiUrl(Astro.url.hostname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={resource.description} />
    <ThemeInit />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased">
    <SiteHeader sourceLabel={source === 'remote' ? 'Configured Git registry' : 'Explicit local index'} showSettings />

    <main class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-8 lg:py-12">
      <a class="btn btn-ghost btn-sm -ml-3" href="/">Back to catalog</a>

      <section class="hero mt-10 max-w-3xl justify-start" aria-labelledby="resource-title">
        <div class="hero-content block max-w-none p-0">
          <div class="flex items-center gap-3 text-xs">
            <span class="font-semibold uppercase tracking-[0.12em] text-primary">{resource.type}</span>
            <span
              class:list={[
                'badge',
                resource.reviewStatus === 'unreviewed' ? 'badge-warning' : 'badge-ghost',
              ]}
            >
              {resource.reviewStatus === 'reviewed' ? 'Reviewed' : 'Unreviewed'}
            </span>
          </div>
          <h1 id="resource-title" class="mt-4 text-3xl font-semibold tracking-tight text-base-content sm:text-4xl">{resource.name}</h1>
          <p class="mt-4 text-base leading-7 text-base-content/60">{resource.description}</p>
        </div>
      </section>

      <div class="stats stats-vertical mt-8 w-full border-y border-base-300 sm:stats-horizontal" aria-label="Resource metadata">
        <div class="stat px-0 py-4 sm:pr-6">
          <div class="stat-title text-xs">Resource ID</div>
          <div class="stat-value mt-1 break-all font-mono text-xs">{resourceKey(resource)}</div>
        </div>
        <div class="stat border-base-300 px-0 py-4 sm:border-l sm:px-6">
          <div class="stat-title text-xs">Latest version</div>
          <div class="stat-value mt-1 text-sm">v{resource.latestVersion}</div>
        </div>
        <div class="stat border-base-300 px-0 py-4 sm:border-l sm:pl-6">
          <div class="stat-title text-xs">Owner</div>
          <div class="stat-value mt-1 text-sm">{resource.owner}</div>
        </div>
      </div>

      {resource.reviewStatus === 'unreviewed' && (
        <div class="alert alert-warning mt-6 max-w-3xl items-start text-sm leading-6" role="status">
          <i class="ph ph-warning text-xl" aria-hidden="true"></i>
          <div>
            This resource is unreviewed. You can stage it, but inspect its contents before applying
            it to a project.
          </div>
        </div>
      )}

      <InstallResource
        client:load
        apiUrl={apiUrl}
        homeDir={homedir()}
        resourceKey={resourceKey(resource)}
        resourceType={resource.type}
        componentResources={componentResources}
        installBase={installBase}
      />
      <SettingsDrawer client:load apiUrl={apiUrl} />

      <section class="mt-14 w-full border-t border-base-300 pt-8" aria-labelledby="files-title">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Source</p>
        <h2 id="files-title" class="mt-2 text-xl font-semibold tracking-tight text-base-content">Files in v{version?.version ?? resource.latestVersion}</h2>
        {fileError ? (
          <div class="alert alert-error mt-5 items-start text-sm" role="alert">
            <i class="ph ph-warning-circle text-xl" aria-hidden="true"></i>
            <div>
              <strong class="font-semibold">Resource files are not available in this checkout.</strong>
              <p class="mt-2">{fileError}</p>
            </div>
          </div>
        ) : version ? (
          <div class="card card-border mt-5 overflow-hidden bg-base-100">
            {version.files.map((file, index) => (
              <details class="collapse collapse-arrow rounded-none border-b border-base-300 last:border-b-0" open={index === 0}>
                <summary class="collapse-title min-h-0 px-4 py-3 text-sm font-medium text-base-content">{file.path}</summary>
                <div class="collapse-content p-0">
                  <div class="mockup-code overflow-x-auto rounded-none border-t border-base-300 bg-base-200 p-4 text-xs leading-6 before:hidden">
                    <pre><code>{file.content}</code></pre>
                  </div>
                </div>
              </details>
            ))}
          </div>
        ) : (
          <div class="card mt-5 border border-base-300 bg-base-100">
            <div class="card-body p-6">
              <strong class="font-semibold text-base-content">No files found.</strong>
              <p class="mt-2 text-sm text-base-content/60">The registry index points to a package with no readable files.</p>
            </div>
          </div>
        )}
      </section>
    </main>

    <footer class="footer mx-auto w-full max-w-6xl border-t border-base-300 px-5 py-6 text-xs text-base-content/60 sm:px-8">
      <p>Backed by the production branch of the resources repository.</p>
      <a class="link link-hover font-medium" href="/">Return to catalog</a>
    </footer>
  </body>
</html>
