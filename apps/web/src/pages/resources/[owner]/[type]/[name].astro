---
import type { ResourceSummary } from '@ai-directory/contracts';
import {
  loadRegistry,
  loadResource,
  resourceId,
  type RegistryView,
} from '../../../../lib/registry';
import ThemeInit from '../../../../components/ThemeInit.astro';
import ThemeToggle from '../../../../components/ThemeToggle.astro';
import '../../../../styles/global.css';

type Props = {
  resource: ResourceSummary;
  version: Awaited<ReturnType<typeof loadResource>>['version'];
  componentResources: string[];
  source: RegistryView['source'];
  fileError?: string;
};

const requestedResourceId = [Astro.params.owner, Astro.params.type, Astro.params.name].join('/');
const registry = await loadRegistry();
const resource = registry.index?.resources.find(
  (candidate) =>
    candidate.lifecycleStatus === 'active' && resourceId(candidate) === requestedResourceId,
);

if (!resource) return Astro.redirect('/');

const result = await loadResource(registry.indexPath, resource, registry.repository);
const { version, componentResources, source, fileError } = {
  resource,
  version: result.version,
  componentResources: result.resources.map((item) => resourceId(item.resource)),
  source: registry.source,
  ...(result.error ? { fileError: result.error } : {}),
} satisfies Props;
const title = `${resource.name} | AI Directory`;
const installBase = `aid install ${resourceId(resource)} --harness claude-code`;
const apiUrl = import.meta.env.PUBLIC_AI_DIRECTORY_API_URL ?? 'http://127.0.0.1:4317';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={resource.description} />
    <ThemeInit />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-canvas font-sans text-ink antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <header class="border-b border-line bg-canvas/95 dark:border-zinc-800 dark:bg-zinc-950/95">
      <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
        <a class="text-sm font-semibold tracking-[0.12em] text-ink dark:text-zinc-100" href="/">
          AI DIRECTORY <span class="ml-2 hidden text-[10px] font-medium tracking-[0.16em] text-muted sm:inline">RESOURCE REGISTRY</span>
        </a>
        <div class="flex items-center gap-4">
          <ThemeToggle />
        <span class="hidden rounded-full border border-line px-2.5 py-1 text-xs font-medium text-muted dark:border-zinc-700 dark:text-zinc-400 sm:inline">
          {source === 'remote' ? 'Configured Git registry' : 'Explicit local index'}
        </span>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-8 lg:py-12">
      <a class="text-sm font-medium text-muted transition-colors hover:text-accent dark:text-zinc-400 dark:hover:text-orange-300" href="/">Back to catalog</a>

      <section class="mt-10 max-w-3xl" aria-labelledby="resource-title">
        <div class="flex items-center gap-3 text-xs">
          <span class="font-semibold uppercase tracking-[0.12em] text-accent">{resource.type}</span>
          <span
            class:list={[
              'rounded-full border px-2 py-0.5 font-medium',
              resource.reviewStatus === 'unreviewed'
                ? 'border-amber-200 bg-warning-soft text-warning dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-300'
                : 'border-line text-muted dark:border-zinc-700 dark:text-zinc-400',
            ]}
          >
            {resource.reviewStatus === 'reviewed' ? 'Reviewed' : 'Unreviewed'}
          </span>
        </div>
        <h1 id="resource-title" class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-zinc-100">{resource.name}</h1>
        <p class="mt-4 text-base leading-7 text-muted dark:text-zinc-400">{resource.description}</p>
      </section>

      <div class="mt-8 grid w-full gap-4 border-y border-line py-5 sm:grid-cols-3 dark:border-zinc-800" aria-label="Resource metadata">
        <div>
          <span class="block text-xs font-semibold text-muted dark:text-zinc-500">Resource ID</span>
          <span class="mt-1 block break-all font-mono text-xs text-ink dark:text-zinc-300">{resourceId(resource)}</span>
        </div>
        <div>
          <span class="block text-xs font-semibold text-muted dark:text-zinc-500">Latest version</span>
          <span class="mt-1 block text-sm text-ink dark:text-zinc-300">v{resource.latestVersion}</span>
        </div>
        <div>
          <span class="block text-xs font-semibold text-muted dark:text-zinc-500">Owner</span>
          <span class="mt-1 block text-sm text-ink dark:text-zinc-300">{resource.owner}</span>
        </div>
      </div>

      {resource.reviewStatus === 'unreviewed' && (
        <div class="mt-6 max-w-3xl rounded-lg border border-amber-200 bg-warning-soft p-4 text-sm leading-6 text-warning dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-300" role="status">
          This resource is unreviewed. You can install it, but inspect its contents before using
          it in a project.
        </div>
      )}

      <section
        class="mt-14 w-full border-t border-line pt-8 dark:border-zinc-800"
        aria-labelledby="install-title"
        data-resource-install
        data-api-url={apiUrl}
        data-resource-id={resourceId(resource)}
        data-resource-type={resource.type}
        data-resource-components={JSON.stringify(componentResources)}
      >
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Install</p>
        <h2 id="install-title" class="mt-2 text-xl font-semibold tracking-tight text-ink dark:text-zinc-100">Use this resource locally</h2>
        {resource.type === 'templates' && (
          <div class="mt-5 rounded-lg border border-amber-200 bg-warning-soft p-4 text-sm leading-6 text-warning dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-300" role="status">
            This template installs its component resources as one pack. You can update or uninstall
            the pack from here later.
          </div>
        )}
        <div class="mt-6 rounded-lg border border-line bg-panel p-5 dark:border-zinc-800 dark:bg-zinc-900">
          <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_12rem]">
            <fieldset>
              <legend class="mb-3 text-xs font-semibold text-muted dark:text-zinc-400">Harnesses</legend>
              <div class="grid gap-3 sm:grid-cols-3">
                <label class="flex items-center gap-2 text-sm text-ink dark:text-zinc-200">
                  <input class="size-4 accent-accent" type="checkbox" value="claude-code" data-install-harness checked />
                  Claude Code
                </label>
                <label class="flex items-center gap-2 text-sm text-ink dark:text-zinc-200">
                  <input class="size-4 accent-accent" type="checkbox" value="opencode" data-install-harness />
                  OpenCode
                </label>
                <label class="flex items-center gap-2 text-sm text-ink dark:text-zinc-200">
                  <input class="size-4 accent-accent" type="checkbox" value="codex" data-install-harness />
                  Codex
                </label>
              </div>
            </fieldset>
            <label class="block" for="install-scope">
              <span class="mb-3 block text-xs font-semibold text-muted dark:text-zinc-400">Scope</span>
              <select class="block min-h-10 w-full rounded-md border border-line bg-canvas px-3 text-sm text-ink outline-none transition focus:border-accent focus:ring-2 focus:ring-accent/20 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100" id="install-scope" data-install-scope>
                <option value="project">This project</option>
                <option value="global">All projects</option>
              </select>
            </label>
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            <button class="inline-flex min-h-10 items-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-50" type="button" data-install-action>Install resource</button>
            <button class="hidden min-h-10 items-center rounded-md border border-line px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-orange-400 dark:hover:text-orange-300" type="button" data-update-action hidden>
              Update resource
            </button>
            <button class="hidden min-h-10 items-center rounded-md border border-line px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-orange-400 dark:hover:text-orange-300" type="button" data-uninstall-action hidden>
              Uninstall
            </button>
            <button class="hidden min-h-10 items-center rounded-md border border-amber-300 px-4 py-2 text-sm font-semibold text-warning transition-colors hover:bg-warning-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent dark:border-amber-700 dark:text-amber-300 dark:hover:bg-amber-950/40" type="button" data-force-action hidden>
              Continue with force
            </button>
          </div>
          <p class="mt-4 text-sm text-muted dark:text-zinc-400" data-install-status role="status">
            Checking local installations…
          </p>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <div class="rounded-md bg-ink p-4 dark:bg-zinc-900">
            <label class="block text-xs font-semibold text-zinc-300" for="project-command">Project scope</label>
            <code class="mt-2 block break-all font-mono text-xs leading-5 text-zinc-100" id="project-command">{installBase} --scope project</code>
          </div>
          <div class="rounded-md bg-ink p-4 dark:bg-zinc-900">
            <label class="block text-xs font-semibold text-zinc-300" for="global-command">Global scope</label>
            <code class="mt-2 block break-all font-mono text-xs leading-5 text-zinc-100" id="global-command">{installBase} --scope global</code>
          </div>
        </div>
      </section>

      <section class="mt-14 w-full border-t border-line pt-8 dark:border-zinc-800" aria-labelledby="files-title">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Source</p>
        <h2 id="files-title" class="mt-2 text-xl font-semibold tracking-tight text-ink dark:text-zinc-100">Files in v{version?.version ?? resource.latestVersion}</h2>
        {fileError ? (
          <div class="mt-5 rounded-lg border border-red-200 bg-red-50 p-5 text-sm dark:border-red-900/70 dark:bg-red-950/30" role="alert">
            <strong class="font-semibold text-red-900 dark:text-red-200">Resource files are not available in this checkout.</strong>
            <p class="mt-2 text-red-800 dark:text-red-300">{fileError}</p>
          </div>
        ) : version ? (
          <div class="mt-5 divide-y divide-line overflow-hidden rounded-lg border border-line bg-panel dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900">
            {version.files.map((file, index) => (
              <details class="group" open={index === 0}>
                <summary class="cursor-pointer list-none px-4 py-3 text-sm font-medium text-ink marker:hidden group-open:text-accent dark:text-zinc-200 dark:group-open:text-orange-300">{file.path}</summary>
                <pre class="overflow-x-auto border-t border-line bg-canvas p-4 text-xs leading-6 text-ink dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-300"><code>{file.content}</code></pre>
              </details>
            ))}
          </div>
        ) : (
          <div class="mt-5 rounded-lg border border-line bg-panel p-6 dark:border-zinc-800 dark:bg-zinc-900">
            <strong class="font-semibold text-ink dark:text-zinc-100">No files found.</strong>
            <p class="mt-2 text-sm text-muted dark:text-zinc-400">The registry index points to a package with no readable files.</p>
          </div>
        )}
      </section>
    </main>

    <footer class="mx-auto flex w-full max-w-6xl flex-col gap-2 border-t border-line px-5 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8 dark:border-zinc-800 dark:text-zinc-500">
      <p>Backed by the production branch of the resources repository.</p>
      <a class="font-medium hover:text-accent dark:hover:text-orange-300" href="/">Return to catalog</a>
    </footer>

    <script>
      type Installation = {
        resource: string;
        version: string;
        harness: string;
        scope: string;
      };
      type Action = 'install' | 'update' | 'uninstall';

      const panel = document.querySelector<HTMLElement>('[data-resource-install]');
      const apiBase = panel?.dataset.apiUrl ?? 'http://127.0.0.1:4317';
      const resourceKey = panel?.dataset.resourceId ?? '';
      let componentKeys: string[] = [];
      try {
        const parsed = JSON.parse(panel?.dataset.resourceComponents ?? '[]');
        if (Array.isArray(parsed)) {
          componentKeys = parsed.filter((item): item is string => typeof item === 'string');
        }
      } catch {
        componentKeys = [];
      }
      const trackedResources = componentKeys.length > 0 ? componentKeys : [resourceKey];
      const harnesses = Array.from(
        document.querySelectorAll<HTMLInputElement>('[data-install-harness]'),
      );
      const scope = document.querySelector<HTMLSelectElement>('[data-install-scope]');
      const install = document.querySelector<HTMLButtonElement>('[data-install-action]');
      const update = document.querySelector<HTMLButtonElement>('[data-update-action]');
      const uninstall = document.querySelector<HTMLButtonElement>('[data-uninstall-action]');
      const force = document.querySelector<HTMLButtonElement>('[data-force-action]');
      const status = document.querySelector<HTMLElement>('[data-install-status]');
      let forceAction: Action | null = null;
      let currentRecords: Installation[] = [];

      function setHidden(element: HTMLElement | null, hidden: boolean) {
        if (!element) return;
        element.hidden = hidden;
        element.classList.toggle('hidden', hidden);
      }

      function selectedHarnesses(): string[] {
        return harnesses.filter((input) => input.checked).map((input) => input.value);
      }

      function showStatus(message: string, isError = false) {
        if (!status) return;
        status.textContent = message;
        status.dataset.error = isError ? 'true' : 'false';
      }

      function hasCompleteInstallation(records: Installation[], harness: string): boolean {
        return trackedResources.every((resource) =>
          records.some((record) => record.resource === resource && record.harness === harness),
        );
      }

      function render(records: Installation[]) {
        currentRecords = records;
        const selected = selectedHarnesses();
        const installed = selected.filter((harness) => hasCompleteInstallation(records, harness));
        const missing = selected.filter((harness) => !hasCompleteInstallation(records, harness));
        setHidden(install, selected.length === 0 || missing.length === 0);
        setHidden(update, selected.length === 0 || installed.length === 0);
        setHidden(uninstall, selected.length === 0 || installed.length === 0);
        setHidden(force, true);
        forceAction = null;

        if (selected.length === 0) {
          showStatus('Select at least one harness.');
          return;
        }

        const installedText = installed.length > 0
          ? `Installed for ${installed.join(', ')}`
          : 'Not installed';
        const missingText = missing.length > 0 ? `Not fully installed for ${missing.join(', ')}` : '';
        showStatus([installedText, missingText].filter(Boolean).join('. ') + '.');
      }

      function targetHarnesses(action: Action): string[] {
        const selected = selectedHarnesses();

        if (action === 'install') {
          return selected.filter((harness) => !hasCompleteInstallation(currentRecords, harness));
        }

        return selected.filter((harness) => hasCompleteInstallation(currentRecords, harness));
      }

      async function request(path: string, init?: RequestInit) {
        const response = await fetch(`${apiBase}${path}`, init);
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error ?? 'The local API request failed.');
        return result;
      }

      async function loadInstallation(): Promise<Installation[]> {
        if (selectedHarnesses().length === 0) {
          render([]);
          return [];
        }

        try {
          const result = await request(
            `/api/installed?scope=${encodeURIComponent(scope?.value ?? 'project')}`,
          );
          const selected = selectedHarnesses();
          const records = Array.isArray(result.installations)
            ? result.installations.filter(
                (item: Installation) =>
                  trackedResources.includes(item.resource) &&
                  selected.includes(item.harness) &&
                  item.scope === scope?.value,
              )
            : [];
          render(records);
          return records;
        } catch (error) {
          showStatus(error instanceof Error ? error.message : 'Could not reach the local API.', true);
          return [];
        }
      }

      function setBusy(busy: boolean) {
        for (const button of [install, update, uninstall, force]) {
          if (button) button.disabled = busy;
        }
        for (const harness of harnesses) harness.disabled = busy;
        if (scope) scope.disabled = busy;
      }

      async function run(action: Action, useForce = false) {
        if (useForce && !window.confirm('This may overwrite or remove local changes. Continue?')) {
          return;
        }

        setBusy(true);
        showStatus('Working…');

        try {
          const targets = targetHarnesses(action);

          if (targets.length === 0) {
            showStatus(action === 'install' ? 'All selected harnesses are installed.' : 'No selected harness is installed.');
            return;
          }

          const body = {
            resource: resourceKey,
            harnesses: targets,
            scope: scope?.value,
            ...(useForce ? { force: true } : {}),
          };
          const result = action === 'uninstall'
            ? await request(
                `/api/installed?resource=${encodeURIComponent(resourceKey)}&harnesses=${encodeURIComponent(targets.join(','))}&scope=${encodeURIComponent(scope?.value ?? '')}${useForce ? '&force=true' : ''}`,
                { method: 'DELETE' },
              )
            : await request(`/api/${action}`, {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(body),
              });
          const warnings = Array.isArray(result.warnings) ? result.warnings : [];
          await loadInstallation();
          if (warnings.length > 0) {
            showStatus(`Completed with warning. Unreviewed: ${warnings.join(', ')}`);
          }
        } catch (error) {
          const message = error instanceof Error ? error.message : 'The operation failed.';
          showStatus(message, true);

          if (action !== 'install' && /modified|ownership hashes/u.test(message)) {
            forceAction = action;
            if (force) {
              setHidden(force, false);
              force.textContent = action === 'update' ? 'Force update' : 'Force uninstall';
            }
          }
        } finally {
          setBusy(false);
        }
      }

      install?.addEventListener('click', () => run('install'));
      update?.addEventListener('click', () => run('update'));
      uninstall?.addEventListener('click', () => run('uninstall'));
      force?.addEventListener('click', () => {
        if (forceAction) void run(forceAction, true);
      });
      for (const harness of harnesses) {
        harness.addEventListener('change', () => void loadInstallation());
      }
      scope?.addEventListener('change', () => void loadInstallation());
      if (panel?.dataset.resourceType !== 'templates') void loadInstallation();
    </script>
  </body>
</html>
