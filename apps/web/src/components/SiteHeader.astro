---
import ThemeToggle from './preact/ThemeToggle';

type Props = {
  showChanges?: boolean;
  showInstalled?: boolean;
  showPublish?: boolean;
  showRefresh?: boolean;
  showSettings?: boolean;
  sourceLabel?: string;
};

const {
  showChanges = false,
  showInstalled = false,
  showPublish = false,
  showRefresh = false,
  showSettings = false,
  sourceLabel,
} = Astro.props;
---

<header class="navbar min-h-16 border-b border-base-300 bg-base-100/95">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
    <div class="navbar-start min-w-0">
      <a class="truncate text-lg font-bold text-base-content" href="/">
        AI DIRECTORY
      </a>
    </div>
    <div class="navbar-end gap-1">
      {showChanges && (
        <label class="btn btn-sm gap-2" for="change-deck-toggle">
          Changes <span class="badge badge-primary badge-xs tabular-nums" data-deck-count>0</span>
        </label>
      )}
      {showInstalled && (
        <label class="btn btn-ghost btn-square btn-sm text-base-content hover:bg-primary/10 hover:text-primary" for="installed-drawer-toggle" title="Installed resources" aria-label="Installed resources">
          <i class="ph ph-package text-lg" aria-hidden="true"></i>
          <span class="sr-only">Installed resources</span>
        </label>
      )}
      {sourceLabel && <span class="badge badge-ghost hidden sm:inline-flex">{sourceLabel}</span>}
      {showPublish && (
        <label class="btn btn-ghost btn-square btn-sm text-base-content hover:bg-primary/10 hover:text-primary" for="publish-drawer-toggle" title="Publish resource" aria-label="Publish resource">
          <i class="ph ph-upload-simple text-lg" aria-hidden="true"></i>
          <span class="sr-only">Publish resource</span>
        </label>
      )}
      {showRefresh && (
        <a class="btn btn-ghost btn-square btn-sm text-base-content hover:bg-primary/10 hover:text-primary" href="/?refresh=1" title="Refresh registry" aria-label="Refresh registry">
          <i class="ph ph-arrow-clockwise text-lg" aria-hidden="true"></i>
          <span class="sr-only">Refresh registry</span>
        </a>
      )}
      <ThemeToggle client:load />
      {showSettings && (
        <label class="btn btn-ghost btn-square btn-sm text-base-content hover:bg-primary/10 hover:text-primary" for="settings-drawer-toggle" title="Settings" aria-label="Settings">
          <i class="ph ph-gear text-lg" aria-hidden="true"></i>
          <span class="sr-only">Settings</span>
        </label>
      )}
    </div>
  </div>
</header>
