<div class="dropdown dropdown-end shrink-0" data-theme-control>
  <button
    class="btn btn-ghost btn-square btn-sm text-base-content hover:bg-primary/10 hover:text-primary"
    type="button"
    data-theme-trigger
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Theme: System"
  >
    <i class="ph ph-monitor text-lg" data-theme-icon="system" aria-hidden="true"></i>
    <i class="ph ph-sun hidden text-lg" data-theme-icon="light" aria-hidden="true"></i>
    <i class="ph ph-moon hidden text-lg" data-theme-icon="dark" aria-hidden="true"></i>
  </button>

  <div
    class="dropdown-content menu menu-sm z-50 mt-2 hidden w-44 rounded-box border border-base-300 bg-base-100 p-1 shadow-lg shadow-neutral/10"
    data-theme-menu
    role="menu"
    aria-label="Choose theme"
  >
    <li>
      <button class="flex w-full items-center justify-between rounded-field text-left text-base-content hover:bg-primary/10 hover:text-primary focus-visible:bg-primary/10 focus-visible:outline-none" type="button" data-theme-option="system" role="menuitemradio" aria-checked="true" tabindex="-1">
        <span>System</span>
        <span class="text-primary" data-theme-check aria-hidden="true">✓</span>
      </button>
    </li>
    <li>
      <button class="flex w-full items-center justify-between rounded-field text-left text-base-content hover:bg-primary/10 hover:text-primary focus-visible:bg-primary/10 focus-visible:outline-none" type="button" data-theme-option="light" role="menuitemradio" aria-checked="false" tabindex="-1">
        <span>Light</span>
        <span class="hidden text-primary" data-theme-check aria-hidden="true">✓</span>
      </button>
    </li>
    <li>
      <button class="flex w-full items-center justify-between rounded-field text-left text-base-content hover:bg-primary/10 hover:text-primary focus-visible:bg-primary/10 focus-visible:outline-none" type="button" data-theme-option="dark" role="menuitemradio" aria-checked="false" tabindex="-1">
        <span>Dark</span>
        <span class="hidden text-primary" data-theme-check aria-hidden="true">✓</span>
      </button>
    </li>
  </div>
</div>

<script>
  type Theme = 'system' | 'light' | 'dark';

  const control = document.querySelector<HTMLElement>('[data-theme-control]');
  const trigger = control?.querySelector<HTMLButtonElement>('[data-theme-trigger]');
  const menu = control?.querySelector<HTMLElement>('[data-theme-menu]');
  const icons = Array.from(
    control?.querySelectorAll<HTMLElement>('[data-theme-icon]') ?? [],
  );
  const options = Array.from(
    control?.querySelectorAll<HTMLButtonElement>('[data-theme-option]') ?? [],
  );
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const storageKey = 'ai-directory-theme';
  const labels: Record<Theme, string> = { system: 'System', light: 'Light', dark: 'Dark' };

  function isTheme(value: string | null): value is Theme {
    return value === 'system' || value === 'light' || value === 'dark';
  }

  function readTheme(): Theme {
    try {
      const stored = localStorage.getItem(storageKey);
      return isTheme(stored) ? stored : 'system';
    } catch {
      return 'system';
    }
  }

  function applyTheme(theme: Theme) {
    const dark = theme === 'dark' || (theme === 'system' && media.matches);
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    document.documentElement.dataset.themePreference = theme;
  }

  function closeMenu(focusTrigger = false) {
    if (!menu || !trigger) return;
    menu.classList.add('hidden');
    trigger.setAttribute('aria-expanded', 'false');
    if (focusTrigger) trigger.focus();
  }

  function openMenu(focusSelected = false) {
    if (!menu || !trigger) return;
    menu.classList.remove('hidden');
    trigger.setAttribute('aria-expanded', 'true');
    if (focusSelected) options.find((option) => option.getAttribute('aria-checked') === 'true')?.focus();
  }

  function setTheme(theme: Theme, persist = true) {
    if (persist) {
      try {
        localStorage.setItem(storageKey, theme);
      } catch {
        // Continue with the in-memory theme when storage is unavailable.
      }
    }

    applyTheme(theme);
    trigger?.setAttribute('aria-label', `Theme: ${labels[theme]}`);
    trigger?.setAttribute('title', `Theme: ${labels[theme]}`);
    for (const icon of icons) icon.classList.toggle('hidden', icon.dataset.themeIcon !== theme);
    for (const option of options) {
      const selected = option.dataset.themeOption === theme;
      option.setAttribute('aria-checked', String(selected));
      option.querySelector<HTMLElement>('[data-theme-check]')?.classList.toggle('hidden', !selected);
    }
  }

  function moveFocus(direction: 1 | -1) {
    const index = options.findIndex((option) => option === document.activeElement);
    const next = (index + direction + options.length) % options.length;
    options[next]?.focus();
  }

  if (control && trigger && menu) {
    setTheme(readTheme(), false);

    trigger.addEventListener('click', () => {
      if (menu.classList.contains('hidden')) openMenu();
      else closeMenu();
    });

    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        openMenu(true);
      }
    });

    for (const option of options) {
      option.addEventListener('click', () => {
        const theme = option.dataset.themeOption;
        if (!theme || !isTheme(theme)) return;
        setTheme(theme);
        closeMenu(true);
      });
      option.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          moveFocus(1);
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          moveFocus(-1);
        } else if (event.key === 'Escape') {
          event.preventDefault();
          closeMenu(true);
        }
      });
    }

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !control.contains(event.target)) closeMenu();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) closeMenu(true);
    });

    const onSystemChange = () => {
      if (readTheme() === 'system') applyTheme('system');
    };
    media.addEventListener?.('change', onSystemChange);
    window.addEventListener('storage', (event) => {
      if (event.key === storageKey) setTheme(readTheme(), false);
    });
  }
</script>
