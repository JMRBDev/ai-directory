---
---

<div class="drawer drawer-end pointer-events-none fixed inset-0 z-50" data-settings-drawer-root>
  <input class="drawer-toggle" id="settings-drawer-toggle" type="checkbox" data-settings-toggle aria-hidden="true" tabindex="-1" />
  <div class="drawer-content pointer-events-none" aria-hidden="true"></div>
  <div class="drawer-side">
    <label class="drawer-overlay bg-neutral/30" for="settings-drawer-toggle" aria-label="Close settings" data-settings-backdrop></label>
    <aside
      class="card card-border min-h-full w-full max-w-xl overflow-y-auto rounded-none bg-base-100 text-base-content shadow-2xl"
      data-settings-drawer
      id="settings-drawer"
      aria-hidden="true"
      aria-labelledby="settings-title"
      role="dialog"
      aria-modal="true"
    >
  <div class="card-body min-h-full overflow-y-auto p-5 sm:p-6">
  <div class="flex shrink-0 items-start justify-between gap-4 border-b border-base-300 pb-5">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Settings</p>
      <h2 id="settings-title" class="mt-2 text-xl font-semibold tracking-tight text-base-content">Registry connection</h2>
      <p class="mt-2 text-sm text-base-content/60">Choose the Git repository used by the local CLI and website.</p>
    </div>
    <button class="btn btn-ghost btn-sm shrink-0" type="button" data-settings-close>Close</button>
  </div>

  <div class="min-h-0 flex-1">
    <div class="mt-5 flex items-center justify-between gap-4">
      <h3 class="text-sm font-semibold text-base-content">Repository</h3>
      <span class="badge badge-ghost" data-settings-source>Loading</span>
    </div>

    <form class="mt-5 space-y-6" data-settings-form>
      <label class="fieldset">
        <span class="fieldset-legend">Git URL</span>
        <input class="input input-bordered w-full" id="settings-repository" name="repository" type="text" placeholder="git@github.com:company/ai-directory-registry.git" autocomplete="off" required />
      </label>

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Save for</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="label cursor-pointer justify-start gap-3 rounded-box border border-base-300 px-3 py-3 has-[:checked]:border-primary has-[:checked]:bg-primary/10">
            <input class="radio radio-primary" type="radio" name="settings-scope" value="user" checked />
            This user
          </label>
          <label class="label cursor-pointer justify-start gap-3 rounded-box border border-base-300 px-3 py-3 has-[:checked]:border-primary has-[:checked]:bg-primary/10">
            <input class="radio radio-primary" type="radio" name="settings-scope" value="project" />
            This project
          </label>
        </div>
      </fieldset>

      <div class="flex flex-wrap gap-3">
        <button class="btn btn-primary" type="submit">Save settings</button>
        <button class="btn btn-ghost" type="button" data-settings-clear>Clear selected scope</button>
      </div>
      <p class="text-sm text-base-content/60" data-settings-status role="status"></p>
    </form>

    <div class="mt-8 border-t border-base-300 pt-5">
      <p class="font-semibold text-base-content">Credentials</p>
      <p class="mt-1 text-sm leading-6 text-base-content/60">AI Directory uses the Git credentials already configured on this computer.</p>
      <div class="mockup-code mt-3 w-fit text-xs">
        <pre data-prefix="$"><code>aid doctor</code></pre>
      </div>
    </div>
  </div>
  </div>
    </aside>
  </div>
</div>

<script>
  const apiUrl = document.documentElement.dataset.apiUrl ?? 'http://127.0.0.1:4317';
  const drawerRoot = document.querySelector<HTMLElement>('[data-settings-drawer-root]');
  const toggle = document.querySelector<HTMLInputElement>('[data-settings-toggle]');
  const side = drawerRoot?.querySelector<HTMLElement>('.drawer-side');
  const root = document.querySelector<HTMLElement>('[data-settings-drawer]');
  const backdrop = document.querySelector<HTMLElement>('[data-settings-backdrop]');
  const close = document.querySelector<HTMLButtonElement>('[data-settings-close]');
  const form = document.querySelector<HTMLFormElement>('[data-settings-form]');
  const repository = document.querySelector<HTMLInputElement>('#settings-repository');
  const source = document.querySelector<HTMLElement>('[data-settings-source]');
  const status = document.querySelector<HTMLElement>('[data-settings-status]');
  const clear = document.querySelector<HTMLButtonElement>('[data-settings-clear]');
  const open = document.querySelector<HTMLButtonElement>('[data-open-settings]');

  function selectedScope(): string {
    return document.querySelector<HTMLInputElement>('input[name="settings-scope"]:checked')?.value ?? 'user';
  }

  function selectScope(value: string) {
    if (value !== 'user' && value !== 'project') return;
    const input = document.querySelector<HTMLInputElement>(`input[name="settings-scope"][value="${value}"]`);
    if (input) input.checked = true;
  }

  function showStatus(message: string, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.dataset.error = String(isError);
  }

  function setOpen(isOpen: boolean) {
    if (!root || !backdrop || !drawerRoot || !toggle) return;
    drawerRoot.classList.toggle('drawer-open', isOpen);
    drawerRoot.classList.toggle('pointer-events-none', !isOpen);
    toggle.checked = isOpen;
    side?.style.setProperty('display', isOpen ? 'grid' : 'none', 'important');
    side?.style.setProperty('visibility', isOpen ? 'visible' : 'hidden', 'important');
    side?.style.setProperty('opacity', isOpen ? '1' : '0', 'important');
    side?.style.setProperty('transition', 'none', 'important');
    root.style.setProperty('transform', `translateX(${isOpen ? '0' : '100'}%)`, 'important');
    root.style.setProperty('translate', isOpen ? '0%' : '100%', 'important');
    root.style.setProperty('transition', 'none', 'important');
    root.setAttribute('aria-hidden', String(!isOpen));
    open?.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('overflow-hidden', isOpen);
    if (isOpen) close?.focus();
  }

  async function loadSettings() {
    try {
      const response = await fetch(`${apiUrl}/api/config`);
      const result = await response.json();
      if (!response.ok) throw new Error(result.error ?? 'Could not load settings.');
      if (repository && result.repository) repository.value = result.repository;
      selectScope(result.source);
      if (source) source.textContent = result.source === 'none' ? 'Not configured' : result.source;
      showStatus(result.repository ? 'Ready to use.' : 'Enter a registry repository to get started.');
    } catch (error) {
      showStatus(error instanceof Error ? error.message : 'Could not reach the local API.', true);
    }
  }

  async function saveSettings() {
    const value = repository?.value.trim() ?? '';
    if (!value) {
      showStatus('A Git URL is required.', true);
      return;
    }

    showStatus('Saving…');
    try {
      const response = await fetch(`${apiUrl}/api/config`, {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ repository: value, scope: selectedScope() }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error ?? 'Could not save settings.');
      if (source) source.textContent = result.source;
      showStatus(result.source !== result.savedScope
        ? `Saved in the ${result.savedScope} config. The ${result.source} setting is still active.`
        : `Saved in the ${result.savedScope} config.`);
    } catch (error) {
      showStatus(error instanceof Error ? error.message : 'Could not save settings.', true);
    }
  }

  async function clearSettings() {
    showStatus('Clearing…');
    try {
      const response = await fetch(`${apiUrl}/api/config?scope=${selectedScope()}`, { method: 'DELETE' });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error ?? 'Could not clear settings.');
      if (repository) repository.value = result.repository ?? '';
      if (source) source.textContent = result.source === 'none' ? 'Not configured' : result.source;
      showStatus(result.source !== 'none' && result.source !== result.clearedScope
        ? `Cleared the ${result.clearedScope} config. The ${result.source} setting is still active.`
        : `Cleared the ${result.clearedScope} config.`);
    } catch (error) {
      showStatus(error instanceof Error ? error.message : 'Could not clear settings.', true);
    }
  }

  open?.addEventListener('click', () => {
    document.querySelector<HTMLButtonElement>('[data-close-review]')?.click();
    setOpen(true);
  });
  close?.addEventListener('click', () => setOpen(false));
  backdrop?.addEventListener('click', () => setOpen(false));
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    void saveSettings();
  });
  clear?.addEventListener('click', () => void clearSettings());
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && root?.getAttribute('aria-hidden') === 'false') setOpen(false);
  });

  void loadSettings();
</script>
