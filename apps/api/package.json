{
  "name": "@ai-directory/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests --exclude 'dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-directory/config": "workspace:*",
    "@ai-directory/server-core": "workspace:*",
    "@hono/node-server": "^2.1.0"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
