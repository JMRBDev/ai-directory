{
  "name": "@ai-directory/installers",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-directory/config": "workspace:*",
    "@ai-directory/contracts": "workspace:*",
    "@ai-directory/registry": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "smol-toml": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "typescript": "^6.0.3"
  }
}
